# Copy to .env and fill in. Never commit .env. `python -m agent keys --folder <dir>` fills the key lines from a folder of key files.
MODEL_API_KEY=            # Meta Model API (dev.meta.ai), used by provider muse-spark
BASETEN_API_KEY=          # provider muse-spark-open-baseten (hackathon key for meta-models/muse-spark-open-1026)
OLLAMA_API_KEY=           # providers muse-spark-open-ollama and gpt-oss-120b-ollama (Ollama Cloud)
ANTHROPIC_API_KEY=        # provider claude-opus-5-5, the closed-model baseline (optional)
# ANTHROPIC_EFFORT=medium
# OLLAMA_MODEL=muse-spark-open
# LOCAL_BASE_URL=http://localhost:11434/v1   # provider "local": any OpenAI-compatible server
# LOCAL_MODEL=muse-spark-open

# paths
BENCHMARK_ROOT=../sas2r-benchmark   # clone of github.com/tomasantony/sas2r-benchmark
# RUNS_DIR=runs

# sandbox: docker (default) or local
# SANDBOX=docker
# SANDBOX_IMAGE=sas2r-sandbox:r4.6
# SANDBOX_MEMORY=6g
# SANDBOX_CPUS=2
# RSCRIPT=Rscript                    # only with SANDBOX=local

# prices used for the budget guard (USD per million tokens); defaults are each vendor's list price
# MUSE_SPARK_PRICE_IN=
# MUSE_SPARK_PRICE_OUT=
# PRICE_<PROVIDER>=in,out
