21         	
22         	OPTIONS SASAUTOS=("<PATH>/whitepapers/utilities", SASAUTOS);
23         	OPTIONS MRECALL MAUTOSOURCE;
24         	
25         	%let ds = ADLBC;
26         	%util_access_test_data(&ds);
27         	%* program requires time point variables, so create dummy content as not available in test data;
28         	DATA &ds;
