623            stat3 = strip(put(std, 8.2));
624            stat4 = strip(put(median, 8.1));
625            stat5 = catx(', ', strip(put(min, 8.1)), strip(put(max, 8.1)));
626        
627            /* Change from baseline stats */
628            if n_chg > 0 then do;
629                chg1 = strip(put(n_chg, 8.));
630                chg2 = strip(put(mean_chg, 8.2));
631                chg3 = strip(put(std_chg, 8.2));
632                chg4 = strip(put(median_chg, 8.2));
633                chg5 = catx(', ', strip(put(min_chg, 8.1)), strip(put(max_chg, 8.1)));
634            end;
635        run;

