79         %include "&pgmpath./utilities/u_titles.sas";
241        
242        /*--- Parameters ---*/
243        %let eff_param = ACTOT;   /* test copy: placeholder filled with the synthetic efficacy parameter */    /* Analysis
243      ! parameter */
244        %let y_label   = Change from Baseline in ADAS-Cog Total Score;
245        
246        /*--- Step 1: Prepare analysis data ---*/
247        proc sql noprint;
248            create table eff as
249            select a.USUBJID, a.TRTA, a.TRTAN,
250                   a.PARAMCD, a.PARAM,
251                   a.AVISIT, a.AVISITN,
252                   a.AVAL, a.BASE, a.CHG,
253                   a.ANL01FL
254            from adam.adeff a
255            inner join adam.adsl b on a.USUBJID = b.USUBJID
256            where b.EFFFL = 'Y'
257                  and a.PARAMCD = "&eff_param."
258                  and a.ANL01FL = 'Y'
259                  and a.CHG ne .
260            order by a.TRTAN, a.AVISITN;
NOTE: SAS threaded sort was used.
NOTE: Table WORK.EFF created, with 650 rows and 11 columns.
                                                           The SAS System


261        quit;
NOTE: PROCEDURE SQL used (Total process time):
      real time           0.02 seconds
      user cpu time       0.00 seconds
      system cpu time     0.03 seconds
      memory              19830.84k
      OS Memory           27972.00k
      Timestamp           10/27/2026 03:52:42 PM
      Step Count                        2  Switch Count  0
      

262        
263        /*--- Step 2: Compute summary statistics by visit and treatment ---*/
264        proc means data=eff nway noprint;
265            class TRTA TRTAN AVISIT AVISITN;
266            var CHG;
267            output out=stats(drop=_type_ _freq_)
268                n=n mean=mean stderr=se
269                lclm=lcl uclm=ucl;
270        run;

NOTE: Multiple concurrent threads will be used to summarize data.
NOTE: There were 650 observations read from the data set WORK.EFF.
