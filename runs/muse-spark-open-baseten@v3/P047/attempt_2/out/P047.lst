273        
274              *--- Replace AVISIT and AVISITN with plot-specific text. NB: Expect exactly 2 visits / usubj, BL & P-BL ---*;
275                proc sort data=css_pooled;
276                  by chgtypen &tn_var paramcd &timepointn usubjid &visitn;
277                run;

