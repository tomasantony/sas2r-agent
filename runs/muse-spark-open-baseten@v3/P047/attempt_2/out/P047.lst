105    /*** BOXPLOT for each PARAMETER and ANALYSIS TIMEPOINT in selected data
106      PROC SHEWHART creates the summary table of stats from "block" (stats) variables
107                    and reads "phases" (visits) from a special _PHASE_ variable
108
109      One box plot for each PARAMETER and ANALYSIS TIMEPOINT.
110      By Visit and Planned Treatment.
111
112      In case of many visits and planned treatments, each box plot will use multiple pages.
113
114      CLEANUP = O blocks the macro from deleting temp data sets after the last parameter & timepoint loop
115
116      TO DO: Confirm whether temp data sets should be explicitly deleted after each parameter & timepoint loop.
117             Could a left-over temp data set interfer with a subsequent loop?
118             Or are temp dsets always initialized within each loop?
119    ***/
120
121      %macro boxplot_each_param_tp(plotds=css_anadata, cleanup=1);
122
123        %local pdx tdx;
124
125        %do pdx = 1 %to &paramcd_n;
126
127          /*** LOOP 1 *****************************************************
128           *** Loop through each PARAMETER, working with ALL TIMEPOINTS ***
129           ****************************************************************/
130            data css_nextparam;
131              set &plotds (where=(paramcd = "&&paramcd_val&pdx"));
132            run;
133
134          %*--- Y-AXIS alternative: Fix Y-Axis MIN/MAX based on all timepoints for PARAM. See Y-AXIS DEFAULT, below. ---*;
135          %*   %util_get_var_min_max(css_nextparam, &m_var, aval_min_max)   *;
136
137          %*--- Analysis Timepoints for this parameter: Num (&ATPTN_N), Names (&ATPTN_NAM1 ...) and Labels (&ATPTN_LAB1 ...) ---*;
138            %util_labels_from_var(css_nextparam, atptn, atpt)
139
140
141          %do tdx = 1 %to &atptn_n;
142
143            /*** LOOP 2 ********************************************************************
144             *** Loop through each TIMEPOINT for this parameter, working with ALL VISITS ***
145             *** NB: PROC SORT here is REQUIRED in order to merge on STAT details, below ***
146             *******************************************************************************/
147              proc sort data=css_nextparam (where=(atptn = &&atptn_val&tdx))
148                         out=css_nexttimept;
149                by avisitn &tn_var;
150              run;
151
152            %*--- Y-AXIS DEFAULT: Fix Y-Axis MIN/MAX based on this timepoint. See Y-AXIS alternative, above. ---*;
153              %util_get_var_min_max(css_nexttimept, &m_var, aval_min_max)
154
155            %*--- Number of visits for this parameter and analysis timepoint: &VISN ---*;
156              %util_count_unique_values(css_nexttimept, avisitn, visn)
157
158            %*--- Create format string to display MEAN and STDDEV to default sig-digs: &UTIL_VALUE_FORMAT ---*;
159              %util_value_format(css_nexttimept, &m_var)
160
161
162            *--- Calculate summary statistics, and merge onto measurement data for use as "block" variables ---*;
163              proc summary data=css_nexttimept noprint;
164                by avisitn &tn_var;
165                var &m_var;
166                output out=css_stats (drop=_type_)
167                       n=n mean=mean std=std median=median min=min max=max q1=q1 q3=q3;
168              run;
169
170              *--- Reminder: PROC SHEWHART reads "phases" (visits) from a special _PHASE_ variable ---*;
171              data css_plot (rename=(avisit=_PHASE_));
172                merge css_nexttimept (in=in_paramcd)
173                      css_stats (in=in_stats);
174                by avisitn &tn_var;
175                label n      = 'n'
176                      mean   = 'Mean'
177                      std    = 'Std Dev'
178                      min    = 'Min'
179                      q1     = 'Q1'
180                      median = 'Median'
181                      q3     = 'Q3'
182                      max    = 'Max';
183              run;
184
185
186            /*** Create TIMEPT var, Calculate visit ranges for pages
187              TIMEPT variable controls the location of by-treatment boxes along the x-axis
188              Create symbol BOXPLOT_TIMEPT_RANGES, a |-delimited string that groups visits onto pages
189                Example of BOXPLOT_TIMEPT_RANGES: 0 <= timept < 7|7 <= timept < 12|
190
191              NB: OUTPUT DSET: CSS_PLOT_TP (%obsolete_prep_shewhart_data adds the _TP suffix)
192            ***/
193
194              %obsolete_prep_shewhart_data(css_plot,
195                                           vvisn=avisitn, vtrtn=&tn_var, vtrt=&t_var, vval=&m_var,
196                                           numtrt=&trtn, numvis=&visn,
197                                           alsokeep=&lo_var &hi_var)
198
199              %obsolete_annotate_outliers(css_plot_tp,
200                                      css_annotate,
201                                      x_var    = TIMEPT,
202                                      y_var    = &m_var,
203                                      low_var  = &lo_var,
204                                      high_var = &hi_var,
205                                      jitter   = &jitter,
206                                      numtrt   = &trtn)
207
208            *--- Graphics Settings - Default HSIZE and VSIZE are suitable for A4 and letter ---*;
209              options orientation=landscape;
210              goptions reset=all device=pdf;
211
212              title     justify=left height=1.2 "Box Plot - &&paramcd_lab&pdx by Visit, Analysis Timepoint: &&atptn_lab&tdx";
213              footnote1 justify=left height=1.0 'Box plot type is schematic: the box shows median and interquartile range (IQR, the box height); the whiskers extend to the minimum';
214              footnote2 justify=left height=1.0 'and maximum data points within 1.5 IQR of the lower and upper quartiles, respectively. Values outside the whiskers are shown as outliers.';
215              footnote3 justify=left height=1.0 'Means are marked with a different symbol for each treatment. Red dots indicate measures outside the normal reference range.';
216
217              axis1     value=none label=none major=none minor=none;
218              axis2     order=( %util_axis_order(%scan(&aval_min_max,1), %scan(&aval_min_max,2)) );
219
220            *--- ODS PDF destination (Traditional Graphics, No ODS or Listing output) ---*;
221              ODS GRAPHICS OFF;
222              ODS LISTING CLOSE;
223              ods pdf author='PhUSE CS Standard Analysis Library'
224                      notoc bookmarklist=none dpi=300
225                      subject='PhUSE CS Measures of Central Tendency'
226                      title="Boxplot of &&paramcd_lab&pdx by Visit for Analysis Timepoint &&atptn_lab&tdx"
227                      file="&outputs_folder\WPCT-F.07.01-sas92-QCshewhart_Box_plot_&&paramcd_val&pdx.._by_visit_for_timepoint_&&atptn_val&tdx...pdf";
228
229
230            /*** LOOP 3 - FINALLY, A Graph ****************************
231             *** - Multiple pages in case of many visits/treatments ***
232             **********************************************************/
233              %local vdx nxtvis;
234              %let vdx=1;
235              %do %while (%qscan(&boxplot_timept_ranges,&vdx,|) ne );
236                %let nxtvis = %qscan(&boxplot_timept_ranges,&vdx,|);
237
238                %util_get_reference_lines(css_plot_tp (where=( &nxtvis )),
239                                          nxt_vrefs,
240                                          low_var  =&lo_var,
241                                          high_var =&hi_var,
242                                          ref_lines=&ref_lines)
243
244                proc shewhart data=css_plot_tp (where=( &nxtvis ));
245                  boxchart &m_var * timept (max q3 median q1 min std mean n &t_var) = &t_var /
246                           annotate = css_annotate (where=( %sysfunc(tranwrd(&nxtvis, timept, x)) ))
247                           boxstyle = schematic
248                           notches
249                           nolegend
250                           ltmargin = 5
251                           blockpos = 3
252                           blocklabelpos = left
253                           blocklabtype=scaled
254                           blockrep
255                           haxis=axis1
256                           vaxis=axis2
257                           %if %length(&nxt_vrefs) > 0 %then
258                             vref=&nxt_vrefs
259                             cvref=RED
260                           ;
261                           idsymbol=square
262                           idcolor=black
263                           nolimits
264                           readphase = all
265                           phaseref
266                           phaselabtype=scaled
267                           phaselegend;
268
269                  label &m_var  = "&&paramcd_lab&pdx"
270                        timept  = 'Visit'
271                        &t_var  = 'Treatment'
272                        n       = 'n'
273                        mean    = 'Mean'
274                        std     = 'Std'
275                        median  = 'Median'
276                        min     = 'Min'
277                        max     = 'Max'
278                        q1      = 'Q1'
279                        q3      = 'Q3';
280                  format mean %scan(&util_value_format, 1, %str( )) std %scan(&util_value_format, 2, %str( ));
281                run;
282
283                %let vdx=%eval(&vdx+1);
284              %end; %* --- LOOP 3 - Pages of box plots, VDX ---*;
285
286            *--- Release the PDF output file! ---*;
287              ods pdf close;
288              ods listing;
289
290          %end; %*--- LOOP 2 - Time Points, TDX ---*;
291
292        %end; %*--- LOOP 1 - Parameters, PDX ---*;
293
294
295        *--- Clean up temp data sets required to create box plots ---*;
296          %if &cleanup %then %util_delete_dsets(css_plot css_plot_tp css_nextparam css_nexttimept css_stats css_annotate);
297
298      %mend boxplot_each_param_tp;
299
300      %boxplot_each_param_tp;
MPRINT(BOXPLOT_EACH_PARAM_TP):   data css_nextparam;
MPRINT(BOXPLOT_EACH_PARAM_TP):   set css_anadata (where=(paramcd = "DIABP"));
MPRINT(BOXPLOT_EACH_PARAM_TP):   run;

