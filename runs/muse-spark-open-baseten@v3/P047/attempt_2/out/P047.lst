136        *--- Replace AVISIT and AVISITN with plot-specific text. NB: Expect exactly 2 visits / usubj, BL & P-BL ---*;
137          proc sort data=css_pooled;
138            by chgtypen &tn_var paramcd atptn usubjid avisitn;
139          run;

