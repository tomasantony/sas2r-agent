215            %*--- User may specify optional intermediate visits in E_VISN. ---*;
216            %*--- Separate these into InterMediate (IM_VISN) visits, and a single EndPoint (EP_VISN) visit ---*;
217              %macro null;
218                %global im_visn ep_visn;
219                %local cnt idx;
220        
221                %let im_visn = ;
222                %let cnt = %sysfunc(countw(&e_visn, %str( )));
223        
224                %if &cnt > 1 %then %do idx = 1 %to %eval(&cnt - 1);
225                  %let im_visn = &im_visn %scan(&e_visn, &idx, %str( ));
226                %end;
227        
228                %let ep_visn = %scan(&e_visn, -1, %str( ));
229              %mend null;
230              %null;
