MPRINT(OBSOLETE_PREP_SHEWHART_DATA):   boxplot_timept_ranges = strip(boxplot_timept_ranges) !!strip(compbl( put(last_timept_end,8.-L) !!' <= timept < '!! put(ceil(timept),8.-L) )) !!'|';
MPRINT(OBSOLETE_PREP_SHEWHART_DATA):   boxes_on_page = 0;
