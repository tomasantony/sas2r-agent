183            *--- Restrict analysis to SAFETY POP and ANALYSIS RECORDS (&a_fl) ---*;
184              data css_anadata;
185                set &m_lb..&m_ds (keep=&ana_variables);
186                where &p_fl = 'Y' and &a_fl = 'Y';
187        
188                *--- NB: Keep Baseline measures, but DO NOT PLOT these for the CHANGE graphic, below ---*;
189                  where also avisitn in (&b_visn &e_visn);
NOTE: WHERE clause has been augmented.
190        
191                *--- Create a Normal Range Outlier variable, for scatter plot overlay ---*;
192                  if (2 = n(&m_var, &lo_var) and &m_var < &lo_var) or
193                     (2 = n(&m_var, &hi_var) and &m_var > &hi_var) then m_var_outlier = &m_var;
194                  else m_var_outlier = .;
195        
196              run;

