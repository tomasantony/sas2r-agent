MPRINT(OBSOLETE_ANNOTATE_OUTLIERS):   if ranuni(41385) > 0.5 then jitter = -1 * jitter;
MPRINT(OBSOLETE_ANNOTATE_OUTLIERS):   x = x + jitter;
