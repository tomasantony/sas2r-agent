134
135        *--- Create Pooled data, so sort after individual studies ---*;
136          data css_pooled;
137            set css_safana
138                css_safana (in=in_pool);
139            if in_pool then do;
140              *--- Leading hex-char 'A0'x forces 'Pooled' results to follow individual studies ---*;
141              studyid = 'A0'x !! 'Pooled';
142              substr(usubjid,1,1) = 'P';
143            end;
144          run;

