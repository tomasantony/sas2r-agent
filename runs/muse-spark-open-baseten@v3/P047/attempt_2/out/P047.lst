203
204      %macro boxplot_each_param_tp(plotds=css_anadata, cleanup=1);
205
206        %local pdx tdx ;
207
208        %do pdx = 1 %to &paramcd_n;
209
210          /*** LOOP 1 *****************************************************
211           *** Loop through each PARAMETER, working with ALL TIMEPOINTS ***
212           ****************************************************************/
213            data css_nextparam;
214              set &plotds (where=(paramcd = "&&paramcd_val&pdx"));
215            run;
216
217          %*--- Analysis Timepoints for this parameter: Num (&ATPTN_N), Names (&ATPTN_VAL1 ...) and Labels (&ATPTN_LAB1 ...) ---*;
218            %util_labels_from_var(css_nextparam, atptn, atpt)
219
220          %*--- Create NXT_REFLINES: a list of reference lines for this parameter, across all timepoints ---*;
221            %util_get_reference_lines(css_nextparam, nxt_reflines,
222                                      low_var=&lo_var, high_var=&hi_var, ref_lines=&ref_lines)
223
224          %*--- Y-AXIS alternative: Fix Y-Axis MIN/MAX based on all timepoints for PARAM. See Y-AXIS DEFAULT, below. ---*;
225          %*--- NB: EXTRA normal range reference lines could expand Y-AXIS range.                                    ---*;
226          %*   %util_get_var_min_max(css_nextparam, &m_var, aval_min_max, extra=&nxt_reflines)   *;
227
228
229          %do tdx = 1 %to &atptn_n;
230
231            /*** LOOP 2 ********************************************************************
232             *** Loop through each TIMEPOINT for this parameter, working with ALL VISITS ***
233             *** NB: PROC SORT here is REQUIRED in order to merge on STAT details, below ***
234             *******************************************************************************/
235              proc sort data=css_nextparam (where=(atptn = &&atptn_val&tdx))
236                         out=css_nexttimept;
237                by studyid avisitn &tn_var;
238              run;
239
240            %*--- Y-AXIS DEFAULT: Set Y-Axis MIN/MAX based on this timepoint. See Y-AXIS alternative, above. ---*;
241            %*--- NB: EXTRA normal range reference lines could expand Y-AXIS range.                          ---*;
242              %util_get_var_min_max(css_nexttimept, &m_var, aval_min_max, extra=&nxt_reflines)
243
244            %*--- Create format string to display MEAN and STDDEV to default sig-digs: &UTIL_VALUE_FORMAT ---*;
245              %util_value_format(css_nexttimept, &m_var)
246
247            %*--- Create macro variable BOXPLOT_BLOCK_RANGES, to subset studies into box plot pages ---*;
248              %util_boxplot_block_ranges(css_nexttimept, blockvar=studyid, catvars=&tn_var);
249
250
251            *--- Calculate summary statistics, KEEP LABELS of VISIT and TRT for plotting, below ---*;
252              proc summary data=css_nexttimept noprint;
253                by studyid avisitn &tn_var studyvisitn avisit &t_var;
254                var &m_var;
255                output out=css_stats (drop=_type_ _freq_)
256                       n=n mean=mean std=std median=median min=datamin max=datamax q1=q1 q3=q3;
257              run;
258
259              /***
260                STACK statistics (do NOT merge) BELOW the plot data, one obs per TREATMENT/VISIT.
261                NB: We need exactly ONE obs per timepoint and trt: AXISTABLE defaults to a SUM function
262              ***/
263              data css_plot;
264                set css_nexttimept
265                    css_stats;
266
267                format mean %scan(&util_value_format, 1, %str( )) std %scan(&util_value_format, 2, %str( ));
268              run;
269
270
271            *--- Graphics Settings - Set defaults for all graphs ---*;
272              options orientation=landscape;
273              goptions reset=all;
274
275              ods graphics on / reset=all;
276              ods graphics    / border=no attrpriority=COLOR;
277
278              title     justify=left height=1.2 "Box Plot - &&paramcd_lab&pdx at &c_mode Baseline and &c_mode Post-Baseline for Multiple Studies and Analysis Timepoint &&atptn_lab&tdx";
279              footnote1 justify=left height=1.0 'Box plot type is schematic: the box shows median and interquartile range (IQR, the box height); the whiskers extend to the minimum';
280              footnote2 justify=left height=1.0 'and maximum data points within 1.5 IQR of the lower and upper quartiles, respectively. Values outside the whiskers are shown as outliers.';
281              footnote3 justify=left height=1.0 'Means are marked with a different symbol for each treatment. Red dots indicate measures outside the normal reference range.';
282              footnote4 justify=left height=1.0 'Baseline and post-baseline blocks have different background colors. BASE = baseline, POST = post-baseline.';
283
284              %let y_axis = %util_axis_order( %scan(&aval_min_max,1,%str( )), %scan(&aval_min_max,2,%str( )) );
285
286            *--- ODS PDF destination (Traditional Graphics, No ODS or Listing output) ---*;
287              ods listing close;
288              ods pdf file="&outputs_folder\WPCT-F.07.06_Box_plot_&&paramcd_val&pdx.._&c_mode._base_post_by_study_for_timepoint_&&atptn_val&tdx...pdf"
289                      notoc bookmarklist=none dpi=300
290                      author="(&SYSUSERID) PhUSE CS Standard Analysis Library"
291                      subject='PhUSE CS Measures of Central Tendency'
292                      title="Boxplot of &&paramcd_lab&pdx at &c_mode Baseline and &c_mode Post-baseline for Multiple Studies and Analysis Timepoint &&atptn_lab&tdx"
293                      ;
294
295
296            /*** LOOP 3 - FINALLY, A Graph ****************************
297             *** - Multiple pages in case of many visits/treatments ***
298             **********************************************************/
299
300              %local vdx nxtvis;
301              %let vdx=1;
302              %do %while (%qscan(&boxplot_block_ranges,&vdx,|) ne );
303                %let nxtvis = %qscan(&boxplot_block_ranges,&vdx,|);
304
305                proc sgrender data=css_plot (where=( %unquote(&nxtvis) )) template=PhUSEboxplot ;
306                  dynamic
307                          _MARKERS    = "&t_var"
308                          _BLOCKLABEL = 'studyid'
309                          _XVAR       = 'studyvisitn'
310                          _YVAR       = "&m_var"
311                          _YOUTLIERS  = 'm_var_outlier'
312
313                          %if %length(&nxt_reflines) > 0 %then %do;
314                            _REFLINES   = "%sysfunc(translate( &nxt_reflines, %str(,), %str( ) ))"
315                          %end;
316
317                          _YLABEL     = "&&paramcd_lab&pdx"
318                          _YMIN       = %scan(&y_axis, 1, %str( ))
319                          _YMAX       = %scan(&y_axis, 3, %str( ))
320                          _YINCR      = %scan(&y_axis, 5, %str( ))
321                          _PERIOD     = 'avisit'
322                          _N          = 'n'
323                          _MEAN       = 'mean'
324                          _STD        = 'std'
325                          _DATAMIN    = 'datamin'
326                          _Q1         = 'q1'
327                          _MEDIAN     = 'median'
328                          _Q3         = 'q3'
329                          _DATAMAX    = 'datamax'
330                          ;
331                run;
332
333                %let vdx=%eval(&vdx+1);
334              %end; %* --- LOOP 3 - Pages of box plots, VDX ---*;
335
336            *--- Release the PDF output file! ---*;
337              ods pdf close;
338              ods listing;
339
340          %end; %*--- LOOP 2 - Time Points, TDX ---*;
341
342        %end; %*--- LOOP 1 - Parameters, PDX ---*;
343
344
345        *--- Clean up temp data sets required to create box plots ---*;
346          %if &cleanup %then %util_delete_dsets(css_nextparam css_nexttimept css_stats css_plot);
347
348      %mend boxplot_each_param_tp;
349
350      %boxplot_each_param_tp;
