MPRINT(OBSOLETE_ANNOTATE_OUTLIERS):   color = "RED";
MPRINT(OBSOLETE_ANNOTATE_OUTLIERS):   text = 'DOT';
MPRINT(OBSOLETE_ANNOTATE_OUTLIERS):   OUTPUT;
MPRINT(OBSOLETE_ANNOTATE_OUTLIERS):   run;

