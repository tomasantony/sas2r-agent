88       /*** Data Prep
89         1. Restrict analysis to SAFETY POP (&p_fl) and ANALYSIS RECORDS (&a_fl)
90         2. Replace AVISIT/AVISITN with values that distinguish BASE and POST values (as needed for box plot)
91         3. Plot requires 'Pooled' data with UNIQUE USUBJID for across-study results
92         4. Plot requires a Study-Visit variable for the X-Axis, to cluster boxes and stats
93       ***/
94         proc sort data=&m_lb..&m_ds (keep=&ana_variables
95                                      where=(&p_fl = 'Y' and &a_fl = 'Y'))
96                    out=css_safana;
97
98           by studyid &tn_var paramcd atptn usubjid avisitn;
99         run;

