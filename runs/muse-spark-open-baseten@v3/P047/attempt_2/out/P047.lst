MPRINT(OBSOLETE_ANNOTATE_OUTLIERS):   y = aval;
MPRINT(OBSOLETE_ANNOTATE_OUTLIERS):   * jitter size is based on Ã‚Â±8% of spacing used for PROC SHEWHART boxplot., *;
