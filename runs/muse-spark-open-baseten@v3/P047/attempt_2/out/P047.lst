149        
150        *** Generate output table;
151        options orientation=landscape;
152        proc report nowd data=trans split='^';
153          by paramn param;
154          column &trtvar trttx bnrindn bnrind
155                ('Post-Baseline Result' ("&pbcat1" n1 pct1) ("&pbcat2" n2 pct2) ("&pbcat3" n3 pct3) ("&pbcat4" n4 pct4));
156        
157          define &trtvar / id order noprint;
158          define trttx / "Treatment" id order flow;
159          define bnrindn / id order noprint;
160          define bnrind / "Baseline^Result" id order flow;
161        
162          define n1 / "n" right;
163          define pct1 / "%" left;
164          define n2 / "n" right;
165          define pct2 / "%" left;
166          define n3 / "n" right;
167          define pct3 / "%" left;
168          define n4 / "n" right;
169          define pct4 / "%" left;
170        
171          break after trttx / skip;
