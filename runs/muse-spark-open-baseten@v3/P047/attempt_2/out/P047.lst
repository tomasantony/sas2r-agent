287        
288              *--- Create Pooled data, so sort after individual studies ---*;
289                data css_pooled;
290                  set css_safana
291                      css_safana (in=in_pool);
292                  if in_pool then do;
293                    *--- Leading hex-char 'A0'x forces 'Pooled' results to follow individual studies ---*;
294                    studyid = 'A0'x !! 'Pooled';
295                    substr(usubjid,1,1) = 'P';
296                  end;
297                run;

