271        
272        /*--- Step 3: Small offset to prevent overlapping points ---*/
273        data plot_data;
274            set stats;
275            /* Offset x-position slightly by treatment for readability */
276            select(TRTAN);
277                when(1) xpos = AVISITN - 0.15;
278                when(2) xpos = AVISITN;
279                when(3) xpos = AVISITN + 0.15;
280                otherwise xpos = AVISITN;
281            end;
282        run;

