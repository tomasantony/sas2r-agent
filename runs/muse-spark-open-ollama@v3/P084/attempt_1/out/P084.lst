================================================================================
DERIVATION DETAILS
================================================================================
ASTDY = ASTDT - TRTSDT + 1 if ASTDT >= TRTSDT else ASTDT - TRTSDT
AENDY = AENDT - TRTSDT + 1 if AENDT >= TRTSDT else AENDT - TRTSDT
TRTEMFL = Y if ASTDT >= TRTSDT and (TRTEDT is missing or ASTDT <= TRTEDT+30) else N
ASEVN: MILD=1, MODERATE=2, SEVERE=3
ARELN: NOT RELATED=1, UNLIKELY=2, POSSIBLY RELATED=3, PROBABLY RELATED=4, RELATED=5
AEDUR = AENDT - ASTDT + 1
AOCCFL = Y for first record per USUBJID when sorted by USUBJID AEBODSYS AEDECOD ASTDT
AOCCSFL = Y for first record per USUBJID+AEBODSYS
AOCCPFL = Y for first record per USUBJID+AEBODSYS+AEDECOD
ASEQ = sequential per USUBJID sorted by STUDYID USUBJID ASTDT AESEQ

