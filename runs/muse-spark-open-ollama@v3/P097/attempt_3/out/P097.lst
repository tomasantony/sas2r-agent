3709       		val = 'Ds Sex';
3710       		dsid = open('ds_sex'); info = ifc(dsid,compress(attrn(dsid,'nobs')),'0'); rc = close(dsid); output;
3711       		val = 'Ds Race';
3712       		dsid = open('ds_race'); info = ifc(dsid,compress(attrn(dsid,'nobs')),'0'); rc = close(dsid);	output;	
3713       		val = 'Ds Ethnicity';
3714       		dsid = open('ds_ethnic'); info = ifc(dsid,compress(attrn(dsid,'nobs')),'0'); rc = close(dsid); output;
