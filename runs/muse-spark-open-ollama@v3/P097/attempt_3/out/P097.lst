107          * Create block variables used to produce table ;
108         data blockraw;
109            length  block1 block2 block3 block4 block5 block6 block7 block8
109      ! block9 $40.;
110            keep block1 block2 block3 block4 block5 block6 block7 block8
110      ! block9 trt wks treatment;
111            set stats;
112        	by wks trt;
113        	if trt=0 then Treatment=' A';
114        	if trt=1 then Treatment=' B';
115               blck2 = n;
116               blck3 = mean;
117               blck4 = std;
118        	   blck5 = min;
119        	   blck6=q1;
120        	   blck7=median;
121        	   blck8=max;
122        	   blck9=q3;
