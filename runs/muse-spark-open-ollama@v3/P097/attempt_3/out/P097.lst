MPRINT(DM_SETUP):   data lkp_arm;
MPRINT(DM_SETUP):   set lkp_arm end=eof;
MPRINT(DM_SETUP):   arm_num = _n_;
MPRINT(DM_SETUP):   arm_display = arm;
MPRINT(DM_SETUP):   if arm_display ne '' and not anylower(arm_display) then do;
MPRINT(DM_SETUP):   length arm_word $50;
MPRINT(DM_SETUP):   i = 1;
MPRINT(DM_SETUP):   arm_word = scan(arm_display,i);
MPRINT(DM_SETUP):   do while (arm_word ne '');
MPRINT(DM_SETUP):   if length(arm_word) > 3 and not anydigit(compress(arm_word)) then 
substr(arm_display,index(arm_display,compress(arm_word)),length(compress(arm_word))) = propcase(compress(arm_word));
MPRINT(DM_SETUP):   if compress(arm_word) in ('MG' 'KG') then 
substr(arm_display,index(arm_display,compress(arm_word)),length(compress(arm_word))) = lowcase(arm_word);
MPRINT(DM_SETUP):   if compress(arm_word) = ('ML') then 
substr(arm_display,index(arm_display,compress(arm_word)),length(compress(arm_word))) = 'mL';
MPRINT(DM_SETUP):   i = i + 1;
MPRINT(DM_SETUP):   arm_word = scan(arm_display,i);
MPRINT(DM_SETUP):   end;
MPRINT(DM_SETUP):   end;
MPRINT(DM_SETUP):   retain total_count 0;
MPRINT(DM_SETUP):   total_count = total_count + arm_count;
MPRINT(DM_SETUP):   call symputx('arm_name_'||put(arm_num,8. -l),trim(arm_display),'g');
MPRINT(DM_SETUP):   call symputx('arm_count_'||put(arm_num,8. -l),trim(put(arm_count,8. -l)),'g');
MPRINT(DM_SETUP):   if eof then do;
MPRINT(DM_SETUP):   call symputx('arm_count',trim(put(_n_,8. -l)),'g');
MPRINT(DM_SETUP):   call symputx('total_count',trim(put(total_count,8. -l)),'g');
MPRINT(DM_SETUP):   end;
MPRINT(DM_SETUP):   run;

