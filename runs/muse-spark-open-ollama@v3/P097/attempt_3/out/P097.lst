134        %macro descrstats(indata=, outdata=, varn=, dec=, name=, ord=);
135           proc sort data=&indata out=__indata;
136              by __dummytrt;
137           run;
138        
139           proc means data=__indata noprint;
140              by __dummytrt;
141        	  var &varn;
142        	  output out=__meansres n=n mean=mean stddev=std min=min max=max q1=q1 q3=q3 median=median;
143           run;
144        
145           data __meansres;
146              set __meansres;
147              nc = put(n,6.0);
148              meanc = put(mean,6.%eval(&dec+1));
149        	  medianc = put(median,6.%eval(&dec+1));
150        	  stdc = put(std,6.%eval(&dec+1));
151        	  q1q3c = trim(put(q1,6.%eval(&dec+1)))||', '||trim(put(q3,6.%eval(&dec+1)));
152        	  minmaxc = trim(put(min,6.%eval(&dec+0)))||', '||put(max,6.%eval(&dec+0));
153           run;
154        
155           proc transpose data=__meansres out=__trout prefix=col;
156              id __dummytrt;
157              var nc meanc stdc minmaxc q1q3c medianc;
