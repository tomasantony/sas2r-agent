62         
63         %macro process(in, out, add);
64         	proc sort data=&in;
65         	  by id visit;
66         	run;
67         
68         	data &out;
69         	 set &in;
70         	 by id visit;
71         	 length label $ 40.;
72         	 length category $15;
73         	 keep visit id trt category label point result;
74         	 retain min&out max&out;
75         	 if first.id then do;
76         	   min&out=lab_test_1;
77         	   max&out=lab_test_1;
78         	 end;
79         	 else do;
80         	  if min&out>lab_test_1 then min&out=lab_test_1;
81         	  if max&out<lab_test_1 then max&out=lab_test_1;
82         	 end;
83         	 if last.id then do;
84         	  category="&out";
85         	  label="Last bse to last pst";
86         	  point=1+&add;
87         	  result=lab_test_1;
88               output;
89         	  label="Min bse to min pst";
90         	  point=4+&add;
91         	  result=min&out;
92               output;
93         	  label="Max bse to max pst";
94         	  point=7+&add;
95         	  result=max&out;
96               output;
97         	 end;
98         	run;
99         %mend process;
