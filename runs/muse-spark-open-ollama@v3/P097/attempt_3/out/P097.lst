1          /********************************************************************/
2          /*    Macros for generating area bar chart data for PROC SGPLOT     */
                                                           The SAS System

3          /********************************************************************/
4          
5          /***************************************************/
6          /*  Basic area bar chart                           */
7          /*  notes:                                         */
8          /*  - The values for the response and width        */
9          /*    input variables are summed.                  */
10         /*  - The response output column contains the      */
11         /*    response values for labeling.                */
12         /*  - The width output column contains the width   */
13         /*    values for labeling.                         */
14         /*                                                 */
15         /*  args:                                          */
16         /*  input - input data set name                    */
17         /*  output - output data set name                  */
18         /*  category - category variable for each bar      */
19         /*  response - variable for the length of each bar */
20         /*  width - variable for the width of each bar     */
21         /***************************************************/
22         %macro genAreaBarDataBasic(input, output, category, response, width);
23         proc summary data=&input nway;
24         class &category;
25         var &response &width;
26         output out=_out_totals_ sum=;
27         run;
28         
29         data &output;
30         retain x 0;
31         label x="&width" y="&response" ID="&category";
32         set _out_totals_;
33         ID=&category;
34         response=&response;
35         width=&width;
36         y=0;
37         x=x;
38         output;
39         y=&response;
40         output;
41         x = x + &width;
42         output;
43         y=0;
44         output;
45         run;
46         %mend;
47         
48         /***************************************************************/
49         /*  Area bar chart with color response                         */
50         /*  notes:                                                     */
51         /*  - The values for the response and width input              */
52         /*    variables are summed.                                    */
53         /*  - The color response is summed by default, but supports    */
54         /*    PROC SUMMARY statistics via the colorStat argument.      */
55         /*  - The response output column contains the                  */
56         /*    response values for labeling.                            */
57         /*  - The width output column contains the width               */
58         /*    values for labeling.                                     */
59         /*                                                             */
60         /*  args:                                                      */
                                                           The SAS System

61         /*  input - input data set name                                */
62         /*  output - output data set name                              */
63         /*  category - category variable for each bar                  */
64         /*  response - variable for the length of each bar             */
65         /*  width - variable for the width of each bar                 */
66         /*  colorResp - continuous variable used to represent color    */
67         /*  colorStat (optional) - the SUMMARY statistic for colorResp */
68         /***************************************************************/
69         %macro genAreaBarDataColorResponse(input, output, category, response, width, colorResp, colorStat=sum);
70         proc summary data=&input nway;
71         class &category;
72         var &colorResp;
73         output out=_out_color_ &colorStat=_colorResponse_;
74         run;
75         
76         proc summary data=&input nway;
77         class &category;
78         var &response &width;
79         output out=_out_totals_ sum=;
80         run;
81         
82         data _merged_;
83         merge _out_totals_ _out_color_;
84         by &category;
85         run;
86         
87         data &output;
88         retain x 0;
89         label x="&width" y="&response" ID="&category" colorResponse="&colorResp";
90         set _merged_;
91         colorResponse=_colorResponse_;
92         ID=&category;
93         response=&response;
94         width=&width;
95         y=0;
96         x=x;
97         output;
98         y=&response;
99         output;
100        x = x + &width;
101        output;
102        y=0;
103        output;
104        run;
105        %mend;
106        
107        
108        /***************************************************/
109        /*  Area bar chart with subgroups                  */
110        /*  notes:                                         */
111        /*  - The values for the response and width        */
112        /*    variables are summed.                        */
113        /*  - Use TEXT plot statements to display the      */
114        /*    subgroup labels and bar labels.              */
115        /*  - The generated subLabel, subLabelX, and       */
116        /*    subLabelY variables can be used to display   */
117        /*    the subgroup values in each segment.         */
118        /*  - The generated label, labelX, and labelY      */
                                                           The SAS System

119        /*    variables can be used to display the         */
120        /*    category values above each bar.              */
121        /*                                                 */
122        /*                                                 */
123        /*  args:                                          */
124        /*  input - input data set name                    */
125        /*  output - output data set name                  */
126        /*  category - category variable for each bar      */
127        /*  response - variable for the length of each bar */
128        /*  width - variable for the width of each bar     */
129        /*  subgroup - variable for the bar segments       */
130        /***************************************************/
131        
132        %macro genAreaBarDataSubgroup(input, output, category, response, width, subgroup);
133        proc summary data=&input nway;
134        class &category;
135        var &width;
136        output out=_out_width_ sum=;
137        run;
138        
139        proc summary data=&input nway;
140        class &category &subgroup;
141        var &response;
142        output out=_out_totals_ sum=;
143        run;
144        
145        data _merged_;
146        merge _out_totals_ _out_width_;
147        by &category;
148        run;
149        
150        data &output;
151        retain curCategory curLabelX curLabelY;
152        retain x 0 y 0 prevY 0 nextY 0 prevX 0;
153        label x="&width" y="&response" ID="&subgroup";
154        set _merged_ end=_last_;
155        ID=&subgroup;
156        if (curCategory ne &category) then do;
157           if x > 0 then do;
158              label = curCategory;
159              labelX = curLabelX;
160              labelY = curLabelY;
161           end;
162           curCategory = &category;
163           y=0;
164           prevY=0;
165        end;
166        else do;
167           y=nextY;
168           prevY = y;
169           x=prevX;
170        end;
171        output;
172        labelX=.;
173        labelY=.;
174        y = y + &response;
175        nextY = y;
176        output;
                                                           The SAS System

177        prevX = x;
178        x = x + &width;
179        output;
180        subLabelX = prevX + ((x-prevX) / 2);
181        subLabelY = prevY + ((y-prevY) / 2);
182        subLabel = &response;
183        curLabelX = prevX + ((x-prevX) / 2);
184        curLabelY = prevY + (y-prevy);
185        y=prevY;
186        output;
187        subLabelX=.;
188        sunLabelY=.;
189        if (_last_) then do;
190           x=.;
191           y=.;
192           label = curCategory;
193           labelX = curLabelX;
194           labelY = curLabelY;
195           output;
196        end;
197        run;
198        %mend;

