4777       					data &lab._arm&i._bl&j._mx&k.;
4778       						length lab $10.;
4779       						%if &num_obs. = 0 %then %do;
4780       						bl&j._count = 0;
4781       						bl&j._percent = 0;
4782       						lab = "&lab._mx&k.";
4783       						%end;
4784       						%else set &lab._arm&i._bl&j._mx&k.;;
4785       					run;
4786       
4787       					data &lab._max_arm&i.;
4788       						set dili_blmax_arm&i.;
                                                           The SAS System

4789       						if LBTEST = "&test.";
4790       						st_&lab._maxlab_arm&i. = maxlab/LBSTNRHI;
4791       						rename maxlab = &lab._maxlab_arm&i.
4792       								arm = arm&i.;
4793       						label maxlab = " ";
4794       						label arm = " ";
4795       						keep usubjid maxlab arm st_&lab._maxlab_arm&i.;
4796       					run;
4797       
4798       					data &lab._maxstdy_arm&i.;
4799       						retain usubjid arm;
4800       						set max_labs_stday;
4801       						if arm = "&&arm&i." & lbtest = "&test.";
4802       						if lbdy <0 then delete;
4803       						st_&lab._maxlab_arm&i. = lbstresn/LBSTNRHI;
4804       						rename lbstresn = &lab._maxlab_arm&i.
4805       								arm = arm&i.
4806       								lbdy = lbdy_arm&i.;
4807       						label lbstresn = " ";
4808       						label lbdy = " ";
4809       						label arm = " ";
4810       						keep usubjid arm lbstresn lbdy st_&lab._maxlab_arm&i.;
