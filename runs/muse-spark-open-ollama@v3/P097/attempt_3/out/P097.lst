61         
62         data Prob;
63           x = 0.73;
64           xbar = 0.8162;
65           s = 0.0801;
66           /* x is how many std errors away from the point estimate? */
67           z = abs(xbar - x) / s;
68           /* probability of being that far or farther from the mean */
69           p = 2*cdf("Normal", -z);
70         run;

