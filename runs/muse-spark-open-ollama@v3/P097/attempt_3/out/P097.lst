5002       		drop order;
5003       	run;
5004       
5005       	data max_bl_tables;
5006       		set altblmax_all astblmax_all alpblmax_all biliblmax_all;
5007       	run;
5008       
5009       /*Enhancement to return hy's law subject id's */
5010       
5011       	data _null_;
5012       		set treatment_arms end=stuff;
5013       		if stuff then output;
5014       		call symput('ngroup',strip(treatment));
5015       	run;
5016       
5017       	%put &ngroup;
5018       
5019       	%macro naming();
                                                           The SAS System

5020       
5021       		data _null_;
5022       			%do i=1 %to &ngroup;
5023       				var&i = "Dili_all_arm&i ";
5024       			%end;
5025       			result=CAT(OF var1-var&ngroup);
5026       			%global result;
5027       			call symput("result",result);
5028       		run;
5029       
5030       	%mend;
5031       
5032       	%naming;
5033       
5034       	%put &result;
5035       
5036       	data test1 (keep=subnum dili_1ds dili_2ds dili_3ds dili_4ds dili_5ds dili_6ds dili_7ds dili_8ds dili_9ds);
5037       		set &result;
5038       		array qual{9} dili_1ds dili_2ds dili_3ds dili_4ds dili_5ds dili_6ds dili_7ds dili_8ds dili_9ds;
5039       		do i=1 to 9;
5040       			if qual(i)=1 then output;
5041       		end;
5042       	run;
5043       
5044       	proc sort data=test1 nodupkey;
5045       		by subnum;
5046       	run;
5047       
5048       	proc sql;
5049       		create table hylawindT (drop=subnum) as
5050       		select b.*, c.* from test1 b
5051       		left outer join USUBJID a
5052       		on b.subnum=a.subnum
5053       		left outer join DM c
5054       		on c.USUBJID=a.USUBJID;
5055       		create table hylawind as
5056       		select dili_1ds, dili_2ds, dili_3ds, dili_4ds, dili_5ds, dili_6ds, dili_7ds, dili_8ds, dili_9ds,
5057       		USUBJID, ARM from hylawindT;
5058       	quit;
5059       
5060       /*End of Enhancement*/
5061       
5062       /*Enhancement to track multiple and conflicting baseline*/
5063       
5064       	proc sort data=lb;
5065       		by USUBJID;
5066       	run;
5067       
5068       	data blconflict1(keep = USUBJID LBTESTCD LBSTRESN LBSTRESU LBSTNRHI LBNAM LBBLFL LBSTAT LBDTC LBDY ARM);
5069       		merge lb(in=a) dm(in=b keep=usubjid arm);
5070       		by usubjid;
5071       		if a and LBBLFL='Y' and ARM ne '';
5072       	run;
5073       
5074       	proc sort data=blconflict1;
5075       		by USUBJID LBTESTCD;
5076       	run;
5077       
                                                           The SAS System

5078       	data blconflict;
5079       		set blconflict1;
5080       		by USUBJID LBTESTCD;
5081       		if not (first.LBTESTCD=1 and last.LBTESTCD=1);
5082       	run;
5083       
5084       /*	proc sort data=blconflict1;*/
5085       /*		by USUBJID LBTESTCD LBSTRESN;*/
5086       /*	run;*/
5087       /**/
5088       /*	data blconflict2 (keep=USUBJID LBTESTCD qual);*/
5089       /*		set blconflict1;*/
5090       /*		by USUBJID LBTESTCD LBSTRESN;*/
5091       /*		qual=1;*/
5092       /*		if (first.LBSTRESN=1 and last.LBSTRESN=1);*/
5093       /*	run;*/
5094       /**/
5095       /*	proc sort data=blconflict2 nodupkey;*/
5096       /*		by USUBJID;*/
5097       /*	run;*/
5098       /**/
5099       /*	proc sort data=blconflict1;*/
5100       /*		by USUBJID LBTESTCD;*/
5101       /*	run;*/
5102       /**/
5103       /*	proc sort data=blconflict2;*/
5104       /*		by USUBJID LBTESTCD;*/
5105       /*	run;*/
5106       /**/
5107       /*	data blconflict (drop=qual);*/
5108       /*		merge blconflict1 blconflict2;*/
5109       /*		by USUBJID LBTESTCD;*/
5110       /*		if qual=1;*/
5111       /*	run;*/
5112       
5113       /* truncate the list at 100 */
5114       
5115       	data blconflict;
5116       		retain usubjid LBTESTCD LBSTRESN LBSTRESU LBSTNRHI Blank1 LBNAM Blank2 Blank3 LBBLFL LBSTAT LBDTC LBDY ARM;
5117       		length usubjid $100.;
5118       		set blconflict;
5119       
5120       		dsid = open('blconflict');
5121       		nobs = attrn(dsid,'nobs');
5122       		rc = close(dsid);
5123       
5124       		if _n_ = 101 then do;
5125       			USUBJID = trim(put(nobs,8. -l))||' events - Truncated at 100';
5126       			LBTESTCD = '';
5127       			LBSTRESN = .;
5128       			LBSTRESU = '';
5129       			LBSTNRHI = .;
5130       			LBNAM = '';
5131       			LBBLFL = '';
5132       			LBSTAT = '';
5133       			LBDTC = '';
5134       			LBDY = .;
5135       			ARM = '';
                                                           The SAS System

5136       			Blank1 = '';
5137       			Blank2 = '';
5138       			Blank3 = '';
5139       		end;
5140       		else if _n_ > 101 then delete;
5141       
5142       		drop dsid nobs rc;
5143       	run;
5144       
5145       /*End of this enhancement*/
5146       
5147       %mend liver_outfmt;
