4326       
4327       /*********************************************/
4328       /*macro to run all analysis through every arm*/
4329       /*********************************************/
4330       %macro liver_arm;
4331       
4332       	%put LIVER LAB ANALYSIS FOR EACH ARM;
4333       
4334       	%do i = 1 %to &num.;
4335       
4336       		%put SEPARATING OUT LABS FOR ARM &i.;
4337       
4338       		data treatment_arms;
4339       			set treatment_arms;
4340       			if treatment = &i. then do;
4341       			call symput("arm&i.", input(arm,$100.));
4342       			call symput("dnom&i.", put(count,5.));
4343       			end;
4344       		run;
4345       
4346       		/*separate out 4 liver labs into their own dataset*/
4347       		data ASTarm&i. ALTarm&i. BILIarm&i. ALParm&i.;
4348       			set labdata;
4349       			if arm = "&&arm&i." then do;
4350       			if LBTESTCD in (&l_alt.) then output ALTarm&i.;
4351       			if LBTESTCD in (&l_ast.) then output ASTarm&i.;
4352       			if LBTESTCD in (&l_bili.) then output BILIarm&i.;
4353       			if LBTESTCD in (&l_alp.) then output ALParm&i.;
4354       			end;
4355       		run;
4356       
4357       		/*rename variables*/
4358       		%MACRO LABS(lab);
4359       			data &lab.arm&i.;
4360       				set &lab.arm&i.;
4361       				rename LBTESTCD = &lab.
4362       					   LBSTRESN = &lab._RES
4363       					   LBSTRESU = &lab._UNIT
4364       					   LBSTNRLO = &lab._LO
4365       					   LBSTNRHI = &lab._HI
4366       					   LBDTC = &lab._DATE;
4367       				label LBTESTCD = " ";
4368       				label LBSTRESN = " ";
4369       				label LBSTRESU = " ";
4370       				label LBSTNRLO = " ";
4371       				label LBSTNRHI = " ";
4372       				label LBDTC = " ";
4373       				if LBDY ge 1;
4374       			RUN;
4375       		%MEND LABS;
4376       
4377       		%LABS (AST);
4378       		%LABS (ALP);
4379       		%LABS (ALT);
4380       		%LABS (BILI);
4381       
4382       		/*flag results above upper limit of normal*/
                                                           The SAS System

4383       		data ALParm&i.;
4384       			set ALParm&i.;
4385       			if ALP_RES = . then ALP_miss = 1;
4386       			if ALP_RES NE . THEN DO;
4387       
4388       				if (ALP_RES GE ALP_HI*2) then ALPx2 = 1;
4389       				if (ALP_RES GE ALP_HI*3) then ALPx3 = 1;
4390       				if (ALP_RES GE ALP_HI*5) then ALPx5 = 1;
4391       				if (ALP_RES GE ALP_HI*10) then ALPx10 = 1;
4392       				if (ALP_RES GE ALP_HI*20) then ALPx20 = 1;
4393       				if ALP_RES LE ALP_HI THEN ALPnorm = 1;
4394       				if ALP_RES GE ALP_HI THEN ALP_GEHI = 1;
4395       				if ALPnorm = 1 and LBBLFL = "Y" then ALP_basenm = 1;
4396       			end;
4397       			keep arm alp alp_date alp_hi alp_lo alp_res alp_unit vnum alp_basenm
4398       			alpnorm alp_gehi alp_miss alpx2 alpx3 alpx5 alpx10 alpx20 subnum usubjid /*studyid*/ LBBLFL;
