3526       /******************************/
3527       /* FORMAT DATASETS FOR OUTPUT */
3528       /******************************/
3529       %macro dm_outfmt;
3530       
3531       	%put FORMAT FOR OUTPUT;
3532       
3533       	/* sort age datasets by age order */
3534       	/* look up age order from LKP_AGE dataset */
3535       	data dm_age_flag;
3536       		set dm_age_flag;
3537       		if _n_ = 1 then do;
3538       			declare hash h(dataset:'lkp_age');
3539       			h.definekey('age_flag');
3540       			h.definedata('age_order');
3541       			h.definedone();
3542       		end;
3543       
3544       		length age_order 8.;
3545       		call missing(age_order);
3546       		rc = h.find();
3547       		drop rc;
3548       	run;
3549       
3550       	proc sort data=dm_age_flag out=dm_age_flag(drop=age_order); by age_order; run;
3551       
3552       	data ds_age_flag;
3553       		set ds_age_flag;
3554       		if _n_ = 1 then do;
3555       			declare hash h(dataset:'lkp_age');
3556       			h.definekey('age_flag');
3557       			h.definedata('age_order');
3558       			h.definedone();
3559       		end;
3560       
3561       		length age_order 8.;
3562       		call missing(age_order);
3563       		rc = h.find();
3564       		drop rc;
3565       	run;
3566       
3567       	proc sort data=ds_age_flag out=ds_age_flag(drop=age_order); by dsdecod age_order; run;
3568       
3569       	/* sort the race dataset, putting other and missing last */
3570       	data dm_race;
3571       		set dm_race;
3572       		if upcase(race) = 'MISSING' then order = 3;
3573       		else if upcase(race ) = 'OTHER' then order = 2;
3574       		else order = 1;
3575       	run;
3576       
3577       	proc sort data=dm_race out=dm_race(drop=order); by order race; run;
3578       
3579       	/* blank out the category terms on subsequent rows */
3580       	%let fi = 1;
3581       	%let var = %scan(&dm_var.,&fi.,%str( ));
3582       	%do %while (%length(&var.) > 0);
3583       		%if %sysfunc(count(%sysfunc(compress(&var.,*,k)),*)) > 0 %then %do;
                                                           The SAS System

3584       			data _null_;
3585       				key = translate(reverse(substr(reverse("&var"),index(reverse("&var."),'*')+1)),' ','*');
3586       				lastkey = reverse(scan(reverse(key),1));
3587       				call symputx('f_key',key);
3588       				call symputx('f_lastkey',lastkey);
3589       				call symputx('f_var',translate("&var.",'_','*'));
3590       			run;
3591       
3592       			data dm_&f_var.;
3593       				set dm_&f_var.;
3594       				by &f_key. notsorted;
3595       				%let fki = 1;
3596       				%let fk_var = %scan(&f_key.,&fki.);
3597       				%do %while (&fk_var. ne );
3598       					if not first.&fk_var. then &fk_var. = '';
3599       					%let fki = %eval(&fki. + 1);
3600       					%let fk_var = %scan(&f_key.,&fki.);
3601       				%end;
3602       			run;
3603       		%end;
3604       		%let fi = %eval(&fi. + 1);
3605       		%let var = %scan(&dm_var.,&fi.,%str( ));
3606       	%end;
3607       	
3608       	%let fi = 1;
3609       	%let var = %scan(&dm_by_ds_var.,&fi.);
3610       	%do %while (&var. ne );
3611       		data ds_&var.;
3612       			set ds_&var.;
3613       			by dsdecod notsorted;
3614       			if not first.dsdecod then dsdecod = '';
3615       
3616       			array num{*} _numeric_;
3617       			do i = 1 to dim(num);
3618       				if num(i) = . then num(i) = 0;
3619       			end;
3620       			drop i;
3621       		run;
3622       		%let fi = %eval(&fi. + 1);
3623       		%let var = %scan(&dm_by_ds_var.,&fi.);
3624       	%end;
3625       
3626       	/* make overall tables */
3627       	data dm_overall_stat;
3628       		retain stat %do i = 1 %to &arm_count.; arm_&i. blank_&i. %end; total;
3629       		set dm_age_stat;
3630       		%do i = 1 %to &arm_count.; call missing(blank_&i.); %end;
3631       		if upcase(stat) = 'MODE' then delete;
3632       	run;
3633       
3634       	data dm_overall;
3635       		retain var val;
3636       		set dm_age_flag(in=a)
3637       		    dm_sex(in=b)
3638       			dm_race(in=c)
3639       			dm_ethnic(in=d)
3640       			;
3641       
                                                           The SAS System

3642       		length var $20 val $100;
3643       		if a then do;
3644       			var = 'Age Group';
3645       			val = age_flag;
3646       		end;
3647       		else if b then do;
3648       			var = 'Sex';
3649       			val = sex;
3650       		end;
3651       		else if c then do;
3652       			var = 'Race';
3653       			val = race;
3654       		end;
3655       		else if d then do;
3656       			var = 'Ethnicity';
3657       			val = ethnic;
3658       		end;
3659       		drop age_flag sex race ethnic;
3660       	run;
3661       
3662       	data dm_overall;
3663       		set dm_overall;
3664       		by var notsorted;
3665       		if not first.var then var = '';
3666       	run;
3667       
3668       %mend dm_outfmt;
