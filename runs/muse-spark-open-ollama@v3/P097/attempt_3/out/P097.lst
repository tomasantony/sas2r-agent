3051       /*****************/
3052       /* preprocessing */
3053       /*****************/
3054       %macro ex_setup;
3055       
3056       	%put *******************************************;
3057       	%put * EXPOSURE ANALYSIS DATASET PREPROCESSING *;	
3058       	%put *******************************************;
3059       
3060       	/* valid EXDOSFRQ values implying a specified number of doses per hour/day/week */
3061       	/* taken from SDTM Terminology 10.06.2010 */
3062       	data exdosfrq;
3063       		infile "&dosfrqpath.\exposure_exdosfrq.csv" dsd delimiter=',' truncover;
3064       		length exdosfrq $20 description $50 frequency $10 unit $1;
3065       		input exdosfrq $ description $ frequency $ unit $;
3066       
3067       		index = index(frequency,'/');
3068       		if not index then exdosfrqn = input(frequency,8.);
3069       		else exdosfrqn = input(substr(frequency,1,index-1),8.) / input(substr(frequency,index+1),8.);
3070       	run;
3071       
3072       	/* store dosing frequency codes in a macro variable */
3073       	/* for use in the panel data checks */
3074       	%global vld_exdosfrq;
3075       	proc sql noprint;
3076       		select "'"||trim(exdosfrq)||"'" into: vld_exdosfrq separated by ' '
3077       		from exdosfrq;
3078       	quit;
3079       
3080       	/* used ACTARM if it is available */
3081       	%if &dm_actarm. %then %do;
3082       		proc datasets library=work;
3083       			modify dm;
3084       			rename %if &dm_arm. %then arm=plannedarm;
3085       			       actarm=arm;
3086       		quit;
3087       	%end;
3088       
3089       	** SORT THE DATASETS AND KEEP THE NEEDED VARIABLES ****;
3090       	data dm;
3091       		set dm;
3092       
3093       		%if &dm_armcd. %then %do;
                                                           The SAS System

3094       			if upcase(ARMCD) in("SCRNFAIL","NOTASSGN") then delete;
3095       		%end;
3096       
3097       		/* put arm into propcase */
3098       		arm_display = arm;
3099       		if arm_display ne '' and not anylower(arm_display) then do;
3100       			length arm_word $50;
3101       			i = 1;
3102       			arm_word = scan(arm_display,i);
3103       			do while (arm_word ne '');
3104       				if length(arm_word) > 3 and not anydigit(compress(arm_word))
3105       						then substr(arm_display,index(arm_display,compress(arm_word)),length(compress(arm_word))) =
3106       							propcase(compress(arm_word));
3107       				if compress(arm_word) in ('MG' 'KG')
3108       					then substr(arm_display,index(arm_display,compress(arm_word)),length(compress(arm_word))) =
3109       						lowcase(arm_word);
3110       				if compress(arm_word) = ('ML')
3111       					then substr(arm_display,index(arm_display,compress(arm_word)),length(compress(arm_word))) = 'mL';
3112       				i = i + 1;
3113       				arm_word = scan(arm_display,i);
3114       			end;
3115       		end;
3116       		arm = arm_display;
3117       		drop arm_display arm_word i;
3118       	run;
3119       
3120       	proc sort data = dm(keep = USUBJID RFSTDTC arm %if &dm_actarm. and &dm_arm. %then plannedarm;);
3121       	  by USUBJID;
3122       	run;
3123       
3124       	data ex;
3125       		set ex;
3126       		format exendt e8601da.;
3127       		format exstdt e8601da.;
3128       		call missing(exendt,exstdt);
3129       
3130       		/* if EXENDTC/EXSTDTC exist, convert them to SAS date format */
3131       		/* put missing values at the end at the next sort using the sort order variable */
3132       		%if &ex_exendtc. %then %do;
3133       			if exendtc ne '' then do;
3134       				exendt = input(exendtc,e8601da.);
3135       				exendt_sort = 1;
3136       			end;
3137       			else do;
3138       				exendt = .;
3139       				exendt_sort = 2;
3140       			end;
3141       		%end;
3142       
3143       		%if &ex_exstdtc. %then %do;
3144       			if exstdtc ne '' then do;
3145       				exstdt = input(exstdtc,e8601da.);
3146       				exstdt_sort = 1;
3147       			end;
3148       			else do;
3149       				exstdt = .;
3150       				exstdt_sort = 2;
3151       			end;
                                                           The SAS System

3152       		%end;
3153       
3154       		%if &ex_extrt. %then %do;
3155       			extrt = propcase(extrt);
3156       		%end;
3157       
3158       		/* if EXDOSFRQ isn't in the EX dataset, create it and initialize it as missing */
3159       		%if not &ex_exdosfrq. %then %do;
3160       			length exdosfrq $1;
3161       			call missing(exdosfrq);
3162       		%end;
3163       
3164       		/* if EXDOSFRM isn't in the EX dataset, create it and initialize it as missing */
3165       		%if not &ex_exdosfrm. %then %do;
3166       			length exdosfrm $1;
3167       			call missing(exdosfrm);
3168       		%end;
3169       
3170       	run;
3171       
3172       
3173       	%if &ex_exendtc. %then %do;
3174       		proc sort data = ex;
3175       		  by USUBJID exendt_sort exendt;
3176       		run;
3177       	%end;
3178       	%else %if &ex_exstdtc. %then %do;
3179       		proc sort data = ex;
3180       		  by USUBJID exstdt_sort exstdt;
3181       		run;
3182       	%end;
3183       
3184       
3185       	** MERGE THE EXPOSURE AND PATIENT DATASETS AND DETERMINE STUDY DAYS AND NUMBER OF DOSES ****;
3186       
3187       	data ex_dm;
3188       		merge ex(in=a) dm(in=b);
3189       		format studydate treatdate enddate date9.;
3190       		by USUBJID;
3191       		if a and b;
3192       
3193       		treatdate = exstdt;
3194       		studydate = input(substr(RFSTDTC,1,10), yymmdd10.);
3195       		enddate = exendt;
3196       
3197       
3198       		/* CALCULATE THE STUDY DAY OF THE EXPOSURE EVENT */
3199       		if enddate = . then do;
3200       		  if treatdate >= studydate then studydays = (treatdate - studydate)+1;
3201       		    else studydays = (treatdate - studydate);
3202       		end;
3203       		else do;
3204       		if enddate >= studydate then studydays = (enddate - studydate)+1;
3205       		  else studydays = (enddate - studydate);
3206       		end;
3207       		*if studydays > 0;
3208       
3209       
                                                           The SAS System

3210       		/* CALCULATE THE PERIOD IN DAYS DURING WHICH THE SUBJECT WAS TAKING DOSES OF THE DRUG */
3211       		studydays0 = lag(studydays);
3212       		if first.usubjid then dose_days = studydays;
3213       		else dose_days = studydays - studydays0;
3214       		if not missing(dose_days) and dose_days <= 0 then dose_days = 1;
3215       
3216       		/* set up a count of matching observations so the hash table lookup is initialized on the first match */
3217       		retain match;
3218       		if a and b then match = sum(match,1);
3219       
3220       		/* LOOK UP THE FREQUENCY OF DOSES PER INTERVAL FROM THE REFERENCE TABLE */
3221       		if match = 1 then do;
3222       			declare hash h(dataset:'exdosfrq');
3223       			h.definekey('exdosfrq');
3224       			h.definedata('exdosfrqn','unit');
3225       			h.definedone();
3226       		end;
3227       
3228       		length exdosfrqn 8. unit $1;
3229       		label exdosfrqn='Dosing Frequency Per Interval' unit='Dosing Frequency Unit';
3230       		call missing(exdosfrqn,unit);
3231       		rc = h.find();
3232       		drop rc;
3233       
3234       		/* if no dose frequency was found, assume one dose per study day */
3235       		if exdosfrqn = . then do;
3236       			exdosfrqn = 1;
3237       			unit = 'd';
3238       		end;
3239       
3240       		/* special case to deal with injections */
3241       		/* only one injection per exposure event */
3242       		if index(upcase(exdosfrm),'INJECTION') then do;
3243       			exdosfrqn = 1;
3244       			unit = 'o';
3245       		end;
3246       
3247       		select (unit);
3248       			when ('h') dose_days_fu = dose_days * 24;
3249       			when ('d') dose_days_fu = dose_days;
3250       			when ('w') dose_days_fu = dose_days / 7;
3251       			when ('m') dose_days_fu = dose_days / 30.4375;
3252       			when ('o') dose_days_fu = 1;
3253       			otherwise;
3254       		end;
3255       
3256       		doses = dose_days_fu * exdosfrqn;
3257       
3258       	run;
3259       
3260       %mend ex_setup;
