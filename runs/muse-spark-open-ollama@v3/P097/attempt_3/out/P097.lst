238          column aedecod trt0 trt54 trt81 cvalue1;
239          define aedecod /"Preferred Term" width = 40 flow;
240          define trt0 /"Placebo#N=&trtcn0" width = 30 flow;
241          define trt54/"Treatment 1#N=&trtcn54" width = 30 flow;
242          define trt81/"Treatment 2#N=&trtcn81" width = 30 flow;
243          define cvalue1/"p-value*b" width = 30 flow;
244        
245          compute before _page_;
246            line @1 "Table 7.5 Summary of Serious Adverse Events";
247        	line @1 "Safety Population";
248            line @1 "-";
249          endcomp;
250        
251            compute after _page_;
252            line @1 "-";
253            line @1 "Denominator for each % is treatment column N";
254        	line @1 "*b = p-values are from Fisher's Exact Test";
255          endcomp;
256          run;

