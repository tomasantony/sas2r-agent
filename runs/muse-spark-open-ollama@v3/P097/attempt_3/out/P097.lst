63         %if &xFac > 4 %then %let xFac=4;
64         %if &xFac < 0.5 %then %let xFac=0.5;
65         
66         %let A=&Tilt;
67         %if &Tilt > 80 %then %let A=80;
68         %if &Tilt < 60 %then %let A=60;
69         
70         %let B=0;
71         
72         %let C=&Rotate;
73         %if &Rotate > -15 %then %let C=-15;
74         %if &Rotate < -75 %then %let C=-75;
