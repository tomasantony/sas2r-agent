2816       %macro dm_setup;
2817       
2818       	/* check whether there are subjects in DM */
2819       	%chk_dm_subj_gt0;
2820       
2821       	/* data checks */
2822       	/* required variables */
2823       	%chk_var(ds=dm,var=usubjid);
2824       	%chk_var(ds=dm,var=age);
2825       	%chk_var(ds=ds,var=dsdecod);
2826       	%chk_var(ds=ds,var=usubjid);
2827       
2828       	data rpt_chk_var_req; set rpt_chk_var; run;
2829       
2830         	/* actual arm or planned arm */
                                                           The SAS System

2831       	%chk_var(ds=dm,var=actarm);
2832       	%chk_var(ds=dm,var=arm);
2833       
2834       	/* insert a row into RPT_CHK_VAR_REQ indicating whether actual arm OR arm exists */
2835       	proc sql noprint;
2836       		insert into rpt_chk_var_req
2837       		set chk = 'VAR',
2838       		    ds = 'DM',
2839       			var = 'ACTARM or ARM',
2840       			condition = 'EXISTS',
2841       			ind = %sysfunc(ifc(&dm_actarm. or &dm_arm.,1,0));
2842       	quit;
2843       
2844       	/* study day of disposition event OR start date of disposition event */
2845       	%chk_var(ds=ds,var=dsstdtc);
2846       	%chk_var(ds=ds,var=dsstdy);	
2847       
2848       	proc sql noprint;
2849       		insert into rpt_chk_var_req
2850       		set chk = 'VAR',
2851       		    ds = 'DM/DS',
2852       			var = 'DSSTDY or DSSTDTC',
2853       			condition = 'EXISTS',
2854       			ind = %sysfunc(ifc(&ds_dsstdy. or &ds_dsstdtc.,1,0));
2855       	quit;  	
2856       
2857       	/* optional variables */
2858       	%chk_var(ds=dm,var=armcd);
2859       	%chk_var(ds=dm,var=ageu);
2860       	%chk_var(ds=dm,var=country);
2861       	%chk_var(ds=dm,var=ethnic);
2862       	%chk_var(ds=dm,var=race);
2863       	%chk_var(ds=dm,var=sex);
2864       	%chk_var(ds=dm,var=siteid);
2865       
2866       	%chk_var(ds=ds,var=dscat);
2867       	%chk_var(ds=ds,var=dsscat);
2868       	%chk_var(ds=ds,var=dsseq);
2869       
2870       	/* set indicator whether all required variables are present */
2871       	%global setup_req_var;
2872       	proc sql noprint;
2873       		select (case when count = 0 then 1 else 0 end) into: setup_req_var
2874       		from (select count(1) as count
2875                     from rpt_chk_var_req
2876                     where ind ne 1);
2877       	quit;
2878       
2879       	%if &dm_subj_gt0. and &setup_req_var. %then %do;
2880       
2881       		%global setup_success;
2882       		%let setup_success = 1;
2883       
2884       		/* used ACTARM if it is available */
2885       		%if &dm_actarm. %then %do;
2886       			proc datasets library=work;
2887       				modify dm;
2888       				rename %if &dm_arm. %then arm=plannedarm;
                                                           The SAS System

2889       				       actarm=arm;
2890       			quit;
2891       		%end;
2892       
2893       		/* arm info */
2894       		proc sql noprint;
2895       			create table lkp_arm as
2896       			select arm, count(1) as arm_count
2897       			from dm	
2898       			where upcase(armcd) not in ('SCRNFAIL','NOTASSGN')
2899       			/*and upcase(arm) ne 'SCREEN FAILURE'*/
2900       			group by arm
2901       			order by arm;
2902       		quit;
2903       
2904       		/* get arm counts and total count; assign arm numbers */
2905       		data lkp_arm;
2906       			set lkp_arm end=eof;
2907       
2908       			arm_num = _n_;
2909       
2910       			/* format arm name */
2911       			arm_display = arm;
2912       			if arm_display ne '' and not anylower(arm_display) then do;
2913       				length arm_word $50;
2914       				i = 1;
2915       				arm_word = scan(arm_display,i);
2916       				do while (arm_word ne '');
2917       					if length(arm_word) > 3 and not anydigit(compress(arm_word))
2918       							then substr(arm_display,index(arm_display,compress(arm_word)),length(compress(arm_word))) =
2918     ! propcase(compress(arm_word));
2919       					if compress(arm_word) in ('MG' 'KG')
2920       						then substr(arm_display,index(arm_display,compress(arm_word)),length(compress(arm_word))) = lowcase(arm_word);
2921       					if compress(arm_word) = ('ML')
2922       						then substr(arm_display,index(arm_display,compress(arm_word)),length(compress(arm_word))) = 'mL';
2923       					i = i + 1;
2924       					arm_word = scan(arm_display,i);
2925       				end;
2926       			end;
2927       
2928       			retain total_count 0;
2929       			total_count = total_count + arm_count;
2930       
2931       			call symputx('arm_name_'||put(arm_num,8. -l),trim(arm_display),'g');
2932       			call symputx('arm_count_'||put(arm_num,8. -l),trim(put(arm_count,8. -l)),'g');
2933       			if eof then do;	
2934       				call symputx('arm_count',trim(put(_n_,8. -l)),'g');
2935       				call symputx('total_count',trim(put(total_count,8. -l)),'g');
2936       			end;
2937       		run;
2938       
2939       		data lkp_arm_out;
2940       			retain arm arm_count;
2941       			set lkp_arm(keep=arm_display arm_count total_count rename=(arm_display=arm)) end=eof;
2942       			output;
2943       			if eof then do;
2944       				arm = 'Overall';
2945       				arm_count = total_count;
                                                           The SAS System

2946       				output;
2947       			end;
2948       			keep arm arm_count;
2949       		run;
2950       
2951       		data dm_original;
2952       			set dm;
2953       		run;
2954       
2955       		/* look up arm numbers for each subject */
2956       		data dm;
2957       			set dm;
2958       
2959       			%if &dm_armcd. %then %do;
2960       				if upcase(armcd) in ('SCRNFAIL','NOTASSGN','NOTTRT') then delete;
2961       			%end;
2962       			run;
2963       
2964       		 data dm;
2965       		 set dm;
2966       			/*if upcase(arm) = 'SCREEN FAILURE' then delete;*/
2967       
2968       			if _n_ = 1 then do;
2969       				declare hash h(dataset:'lkp_arm');
2970       				h.definekey('arm');
2971       				h.definedata('arm_num');
2972       				h.definedone();
2973       			end;
2974       
2975       			length arm_num 8.;
2976       			call missing(arm_num);
2977       			rc = h.find();
2978       			drop rc;
2979       
2980       			if not &dm_age. then age = .;
2981       			if not &dm_country. then country = 'Missing';
2982       			if not &dm_ethnic. then ethnic = 'Missing';
2983       			if not &dm_race. then race = 'Missing';
2984       			if not &dm_sex. then sex = 'Missing';
2985       			if not &dm_siteid. then siteid = 'Missing';
2986       
2987       			%let i = 1;
2988       			%let var = %scan(country ethnic race sex,&i.);
2989       			%do %while (&var. ne );
2990       				%if &&&dm_&var.. %then %do;
2991       					%if &&&dm_&var._len. < 9 %then %do;
2992       						length &var._ext $9;
2993       						if &var. = '' then &var._ext = 'Missing';
2994       						else &var._ext = &var.;	
2995       						rename &var.=dm_&var.;
2996       						rename &var._ext=&var.;
2997       					%end;
2998       					%else %do;
2999       						if &var. = '' then &var. = 'Missing';
3000       					%end;
3001       				%end;
3002       				%let i = %eval(&i.+1);
3003       				%let var = %scan(country ethnic race sex,&i.);
                                                           The SAS System

3004       			%end;
3005       
3006       
3007       			ethnic = propcase(ethnic);
3008       			race = propcase(race);
3009       		run;
3010       
3011       		/*****************/
3012       		/* AGE BUCKETING */
3013       		/*****************/
3014       
3015       		/* determine number of age flag buckets */
3016       		data lkp_age;
3017       			length age_sl 8. ageu_sl $6;
3018       			%let i = 1;
3019       			%do %while (%symexist(age_grp&i.));
3020       				%if (%length(&&&age_grp&i.) = 0) %then %goto age_exit;
3021       				%else %do;
3022       					age_sl = %sysevalf(%scan(&&&age_grp&i.,1,%str( )));
3023       					/*ageu_sl = ifc(not missing("%scan(&&&age_grp&i.,2)"),lowcase("%scan(&&&age_grp&i.,2)"),'years');*/
3024       					ageu_sl = "&ageunit.";
3025       					output;
3026       				%end;
3027       				%let i = %eval(&i. + 1);
3028       			%end;
3029       			%age_exit: %let age_count = %eval(&i. - 1);
3030       		run;
3031       
3032       		/* this gets rid of duplicate rows */
3033       		/* the database puts the catchall category in a separate row, whose value gets written as its min, */
3034       		/* which is a duplicate of the next to last bucket's max */
3035       		proc sort data=lkp_age nodupkey; by age_sl ageu_sl; run;
3036       
3037       		/* convert age input from Script Launcher to age in years */
3038       		data lkp_age;
3039       			set lkp_age end=eof;
3040       
3041       			label min_age='Age Bucket Min Age'
3042       	              max_age='Age Bucket Max Age'
3043       				  min_age_yr='Age Bucket Min Age in Years'
3044       	              max_age_yr='Age Bucket Max Age in Years';
3045       
3046       			max_age = age_sl;
3047       			min_age = lag(max_age);
3048       
3049       			/* convert SL ages to ages in years */
3050       			select (lowcase(compress(ageu_sl,,'ak')));
3051       				when ('yr','year','years') max_age_yr = age_sl;
3052       				when ('mo','month','months') max_age_yr = age_sl/12;
3053       				when ('wk','week','weeks') max_age_yr = age_sl/52.178571428571428571428571428571;
3054       				when ('dy','day','days') max_age_yr = age_sl/365.25;
3055       				when ('hr','hour','hours') max_age_yr = age_sl/8766;
3056       				otherwise max_age_yr = .;
3057       			end;
3058       
3059       			min_age_yr = lag(max_age_yr);
3060       
3061       			/* first age bucket */
                                                           The SAS System

3062       			if _n_ = 1 then do;
3063       				min_age = 0;
3064       				min_age_yr = 0;
3065       			end;
3066       
3067       			output;
3068       
3069       			/* last age bucket */
3070       			if eof then do;
3071       				min_age = max_age;
3072       				min_age_yr = max_age_yr;
3073       				max_age = 200;
3074       				max_age_yr = 200;
3075       				output;
3076       			end;
3077       		run;
3078       
3079       		/* assign age bucket labels */
3080       		data lkp_age;
3081       			set lkp_age end=eof;
3082       
3083       			length min_ageu $6 max_ageu $6
3084       	               min_ageu_txt $6 max_ageu_txt $6;
3085       
3086       			select (lowcase(compress(ageu_sl,,'ak')));
3087       				when ('yr','year','years') ageu_txt = ifc(age_sl<=1,'year','years');
3088       				when ('mo','month','months') ageu_txt = ifc(age_sl<=1,'month','months');
3089       				when ('wk','week','weeks') ageu_txt = ifc(age_sl<=1,'week','weeks');
3090       				when ('dy','day','days') ageu_txt = ifc(age_sl<=1,'day','days');
3091       				when ('hr','hour','hours') ageu_txt = ifc(age_sl<=1,'hour','hours');
3092       				otherwise max_age_yr = .;
3093       			end;
3094       
3095       			max_ageu = ageu_txt;
3096       			min_ageu = lag(max_ageu);
3097       
3098       			if min_ageu =: max_ageu =: 'year' then do;
3099       				min_ageu_txt = '';
3100       				max_ageu_txt = '';
3101       			end;
3102       			else do;
3103       				min_ageu_txt = min_ageu;
3104       				max_ageu_txt = max_ageu;
3105       			end;
3106       
3107       			length age_flag $50;
3108       			if _n_ = 1 then age_flag = 'Age under '||trim(put(max_age,fract8. -l))||' '||trim(max_ageu_txt);
3109       			else if eof then age_flag = 'Age '||trim(put(min_age,fract8. -l))||' '||trim(min_ageu_txt)||' and over';
3110       			else age_flag = 'Age between '||trim(put(min_age,fract8. -l))||' '||trim(min_ageu_txt)||
3111       	                               ' and '||trim(put(max_age,fract8. -l))||' '||trim(max_ageu_txt);
3112       			age_flag = compbl(age_flag);
3113       
3114       			/* add order number */
3115       			age_order = _n_;
3116       
3117       			output;
3118       			
3119       			/* add missing age bucket */
                                                           The SAS System

3120       			if eof then do;
3121       				age_flag = 'Missing';
3122       				call missing(min_age,min_age_yr,min_ageu,max_age,max_age_yr,max_ageu); age_order = 99;
3123       				output;
3124       			end;
3125       
3126       			drop age_sl ageu_sl ageu_txt min_ageu_txt max_ageu_txt;
3127       		run;
3128       
3129       		data lkp_age;
3130       			retain age_flag min_age min_ageu max_age max_ageu min_age_yr max_age_yr age_order;
3131       			set lkp_age;
3132       		run;
3133       
3134       		/* add the age flags to the DM dataset */
3135       		proc sql noprint;
3136       			create table dm_age_flag as
3137       			select a.*, b.age_flag
3138       			from dm a,
3139       	             (select a.usubjid,
3140       	                     (case when b.age_flag is not missing then b.age_flag else 'Missing' end) as age_flag
3141       				  from (select usubjid,
3142       				               %if &dm_ageu. %then %do;
3143       			            	   (case
3144       									when upcase(ageu) like 'YEAR_' then age
3145       									when upcase(ageu) like 'MONTH_' then age*12
3146       									when upcase(ageu) like 'WEEK_' then age*52.178571428571428571428571428571
3147       									when upcase(ageu) like 'DAY_' then age*365.25
3148       									when upcase(ageu) like 'HOUR_' then age*8766
3149       									else .
3150       						  		end) as age
3151       								%end;
3152       								%else %do;
3153       								age
3154       								%end;
3155       				  		from dm) a
3156       				  left join lkp_age b
3157       			      on b.min_age_yr <= age < max_age_yr)	b
3158       			where a.usubjid = b.usubjid
3159       			order by usubjid;
3160       
3161       			drop table dm;
3162       		quit;
3163       
3164       		proc datasets library=work nolist;
3165       			change dm_age_flag=dm;
3166       		quit;
3167       
3168       		proc sort data=dm; by usubjid; run;
3169       		proc sort data=ds; by usubjid; run;
3170       
3171       		/* merge demographic information onto the disposition domain dataset */
3172       		data ds_dm;
3173       			merge ds(in=a)
3174       			      dm(in=b);
3175       			by usubjid;
3176       			if a and b;
3177       
                                                           The SAS System

3178       			if not anylower(dsdecod) then dsdecod = propcase(dsdecod);
3179       
3180       			if not &ds_dscat. then dscat = 'Missing';
3181       			if not &ds_dsscat. then dsscat = 'Missing';
3182       
3183       			%if &ds_dsstdtc. %then %do;
3184       				format dsstdt e8601da.;
3185       				dsstdt = input(dsstdtc,?? e8601da.);
3186       			%end;
3187       
3188       			if upcase(dsdecod) = 'DEATH' then order = 100;
3189       			else order = 1;
3190       		run;
3191       
3192       		/* keep one of each kind of disposition event per subject, category, and subcategory */
3193       		proc sort data=ds_dm;
3194       			by usubjid
3195       			   dscat
3196       			   dsscat
3197       			   %if &ds_dsstdtc. %then dsstdt;
3198       			   %else %if &ds_dsstdy. %then dsstdy;
3199       			   order
3200       			   %if &ds_dsseq. %then dsseq;
3201       			   dsdecod;
3202       		run;
3203       
3204       		data ds_dm
3205       		     ds_dm_pre;
3206       			set ds_dm;
3207       			by usubjid dscat dsscat;
3208       
3209       			if upcase(dscat) = 'PROTOCOL MILESTONE'
3210       			or upcase(dsdecod) =: 'INFORMED CONSENT OBTAINED'
3211       			or upcase(dsdecod) =: 'RANDOMIZED'
3212       			then output ds_dm;
3213       			else if last.dsscat then output ds_dm;
3214       			else output ds_dm_pre;
3215       		run;
3216       
3217       		/* sort by subject and disposition event, removing duplicates, to avoid double counting */
3218       		proc sort data=ds_dm dupout=ds_dm_dup nodupkey;
3219       			by usubjid dsdecod;
3220       		run;
3221       
3222       	%end;
3223       	%else %do;
3224       		%global setup_success;
3225       		%let setup_success = 0;
3226       
3227       		%if not &dm_subj_gt0. %then %put ERROR: There are no subjects in DM;
3228       		%if not &setup_req_var. %then %put ERROR: Required variables are missing;
3229       	%end;
3230       
3231       %mend dm_setup;
