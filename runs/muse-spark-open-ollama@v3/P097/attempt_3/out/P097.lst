26         %MACRO scriptathon_target24 ;
27         
28           ** DETERMINE HOW MANY ACTIVE TREATMENT GROUPS THERE ARE IN ORDER TO LOOP FOR EACH ONE ***;
29           %let _num_groups = 0 ;
30           proc sql noprint;
31             select count(distinct trt01a) into: _num_groups
32             from   work.adsl
33           ;
34           quit ;
35           %let _num_groups = %trim(%left(&_num_groups)) ;
36           %put _num_groups = &_num_groups ;
37         
38         
39         
40           %MACRO AEstat (  dsin    = work.adae
41                          , byvar   =
42                          , tclause =
43                          , wclause = %STR()
44                         ) ;
45         
46             %LET paramcount = %EVAL(&paramcount. + 1) ;
47         
48             proc sort data= work.adae ;
49               BY &byvar. ;
50             run ;
51         
52             PROC MEANS DATA = work.adae ;
53               BY &byvar. ;
54               &wclause. ;
55               OUTPUT OUT = work.stat&paramcount.
56                       n  = n
57               ;
58             QUIT ;
59         
60           %MEND AEstat ;
61         
62           %LET paramcount = 0 ;
63         
64           *** number of subjects experiencing treatment emergent adverse events *** ;
65           %AEstat (dsin = work.adae , byvar = trtan , tclause = trtemfl  , wclause = %NRSTR(WHERE UPCASE(STRIP(SAFFL)) ='Y' AND
65       ! UPCASE(STRIP(AOCCFL))='Y')) ;
66         
67           *** number of subjects experiencing treatment emergent adverse events *** ;
68           %AEstat (dsin = work.adae , byvar = trtan aesoc , tclause = AOCCSFL  , wclause = %NRSTR(WHERE UPCASE(STRIP(SAFFL)) ='Y'
68       !  AND UPCASE(STRIP(AOCCSFL))='Y')) ;
