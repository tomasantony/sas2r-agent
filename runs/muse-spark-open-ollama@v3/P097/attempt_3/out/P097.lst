4969       /* MERGE TOGETHER TABLES FOR ALL LIVER LAB TESTS */
4970       /*************************************************/
4971       %macro liver_outfmt;
4972       
4973       	%put PUT DATASETS TOGETHER FOR OUTPUT;
4974       
4975       	data ast_bili_max_all;
