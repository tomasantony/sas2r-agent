96         /* Create the template for the graph*/
97         /* Used a sample program on SAS web site as reference*/
98         proc template;
99         define statgraph dbp_profile;
100        dynamic title;
101        begingraph / designwidth=17in designheight=14.5in;
102        entrytitle title;
103        layout lattice / columndatarange=union rowweights=(0.8 .05 .05 .05 .05);
104        layout overlay / cycleattrs=true yaxisopts=(label='Mean(unit)with 95% CI' griddisplay=on)
105        xaxisopts=(label='Weeks Since Randomized' offsetmin=0.05 offsetmax=0.05
106        linearopts=(tickvaluelist=(0 2 4 6 8 10 12 16 20 24 26)));
107        scatterplot x=eval(xc-0.05) y=a_mean / yerrorlower=a_lcl yerrorupper=a_ucl name='as'
108                                                        markerattrs=graphdata2(size=9px weight=bold)
109                                                        errorbarattrs=graphdata2(pattern=solid thickness=2);
110        scatterplot x=eval(xc+0.05) y=b_mean / yerrorlower=b_lcl yerrorupper=b_ucl name='bs'
111                                                        markerattrs=graphdata3(size=9px weight=bold)
112                                                        errorbarattrs=graphdata3(pattern=solid thickness=2);
113        scatterplot x=eval(xc+0.15) y=c_mean / yerrorlower=c_lcl yerrorupper=c_ucl name='cs'
114                                                        markerattrs=graphdata4(size=9px weight=bold)
115                                                        errorbarattrs=graphdata4(pattern=solid thickness=2);
116        seriesplot x=eval(xc-0.05) y=a_mean / lineattrs=graphdata2(pattern=shortdash thickness=2px) name='al';
117        seriesplot x=eval(xc+0.05) y=b_mean / lineattrs=graphdata3(pattern=mediumdash thickness=2px) name='bl';
118        seriesplot x=eval(xc+0.15) y=c_mean / lineattrs=graphdata4(pattern=dash thickness=2px) name='cl';
119        endlayout;
120        layout overlay;
121        entry halign=left 'At Risk Subjects';
122        endlayout;
123        blockplot x=xc block=c_n / display=(values label) valuehalign=center label='81' repeatedvalues=true
124                                             valueattrs=graphdata4 labelattrs=graphdata4;
125        blockplot x=xc block=b_n / display=(values label) valuehalign=center label='54' repeatedvalues=true
126                                             valueattrs=graphdata3 labelattrs=graphdata3;
127        blockplot x=xc block=a_n / display=(values label) valuehalign=center label='0' repeatedvalues=true
128                                             valueattrs=graphdata2 labelattrs=graphdata2;
129        sidebar / spacefill=false;
130        discretelegend  'al' 'bl' 'cl' / title='Treatment Group: ' across=3;
131        endsidebar;
132        endlayout;
133        endgraph;
