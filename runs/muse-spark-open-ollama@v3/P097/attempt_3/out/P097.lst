      OS Memory           20720.00k
      Timestamp           10/27/2026 03:46:58 PM
      Step Count                        5  Switch Count  0
      

425        
426        /*--- Step 3: Get baseline grade per subject per parameter ---*/
427        proc sql noprint;
428            create table bl_grade as
429            select distinct USUBJID, TRTA, TRTAN, PARAMCD, PARAM,
                                                           The SAS System

430                   BTOXGR as bl_grade
431            from lb
432            where ABLFL = 'Y' and BTOXGR ne '';
NOTE: Table WORK.BL_GRADE created, with 1920 rows and 6 columns.

433        quit;
