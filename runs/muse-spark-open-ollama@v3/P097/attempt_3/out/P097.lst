108        
109        %macro process(in, out);
110        	proc sort data=&in;
111        	  by sdyname id visid;
112        	run;
113        
114        	data &out;
115        	 set &in;
116        	 by sdyname id visid;
117        	 length label $ 40.;
118        	 length category $15;
119        	 keep visid id trt category label result sdyname sdyid study dur;
119      ! *posit_inc;
120        	 retain Min&out Max&out;
121        	 if first.id then do;
122        	   Min&out=lab_test_1;
123        	   Max&out=lab_test_1;
124        	 end;
125        	 else do;
126        	  if Min&out>lab_test_1 then Min&out=lab_test_1;
127        	  if Max&out<lab_test_1 then Max&out=lab_test_1;
128        	 end;
129        	 if last.id then do;
130        	  category="&out";
131        	  label="last BSE to last PST";
132        	  *posit_inc=1; /*position the different category Min2Min, Max2Max,
132      ! last2last*/
133        	  result=lab_test_1;
134              output;
135        	  *posit_inc=2;
136        	  label="Min BSE to Min PST";
137        	  result=Min&out;
138              output;
139        	  *posit_inc=3;
140        	  label="Max BSE to Max PST";
141        	  result=Max&out;
                                 The SAS System

142              output;
143        	 end;
144        	run;
145        %mend process;
146        %process(Base, BSE);

