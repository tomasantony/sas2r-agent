10          data one;
11              do study = 1 to 4 ;
12         	   input n mean std;
13         	   dur=round(mean*10);
14         	   sdydur=compress('Study_'||study||'('||dur||'wks)');
15                label lab_test_1='Measure (unit)';
16                do i = 1 to n;
17         		   do trt=0 to 1;
18         		       id=i+study*1000+trt*100;
