1          /****************************************************************************/
2          /*         PROGRAM NAME: Liver Lab Analysis Panel                           */
                                                           The SAS System

3          /*                                                                          */
4          /*          DESCRIPTION: Find counts of subjects with abnormal lab tests    */
5          /*                        in multiples of a reference high                  */
6          /*                        and in combination                                */
7          /*                        for lab tests ALP, ALT, AST, and TB               */
8          /*                                                                          */
9          /*      EVALUATION TYPE:                                                    */
10         /*                                                                          */
11         /*               AUTHOR: Shannon Dennis (shannon.dennis@fda.hhs.gov)        */
12         /*                                                                          */
13         /*                 DATE: December 29, 2009                                  */
14         /*                                                                          */
15         /*  EXTERNAL FILES USED: Liver_Labs_Template.xls -- Excel template          */
16         /*                       data_checks.sas -- Generic variable checks         */
17         /*                       data_checks_liver.sas -- DS data checks            */
18         /*                       sl_gs_output.sas -- Script Launcher settings output*/
19         /*                                                                          */
20         /*  PARAMETERS REQUIRED: saspath -- location of external panel SAS programs */
21         /*                       utilpath -- location of external util SAS programs */
22         /*                       ndabla -- NDA or BLA number                        */
23         /*                       studyid -- study number                            */
24         /*                       liverout -- filename and path of output            */
25         /*                                                                          */
26         /*           LOCAL ONLY: studypath -- location of the drug study datasets   */
27         /*                       outpath -- location of the output                  */
28         /*                       outfile -- filename of the output                  */
29         /*                       templatepath -- location of the Excel template     */
30         /*                       template -- filename of the template               */
31         /*                                                                          */
32         /*   VARIABLES REQUIRED: DM -- ACTARM or ARM                                */
33         /*                             USUBJID                                      */
34         /*                       LB -- USUBJID                                      */
35         /*                             LBDTC                                        */
36         /*                             LBTESTCD                                     */
37         /*                             LBSTNRHI                                     */
38         /*                             LBSTRESN                                     */
39         /*                             LBSTRESU                                     */
40         /*                             LBSTNRLO                                     */
41         /*                                                                          */
42         /* OTHER VARIABLES USED: DM -- ARMCD                                        */
43         /* IF AVAILABLE                RFSTDTC                                      */
44         /*                       LB -- LBDY                                         */
45         /*                             LBBLFL                                       */
46         /*                             VISITNUM                                     */
47         /*                                                                          */
48         /*            MADE WITH: SAS 9.2                                            */
49         /*                                                                          */
50         /*                NOTES:                                                    */
51         /*                                                                          */
52         /****************************************************************************/
53         
54         /* REVISIONS */
55         /*
56         2011-03-11 DK  Added data checks
57                        Moved separate parts of the program into separate macros
58                        Updated template to uniform panel style
59         
60         2011-03-27 DK  Added run location handling
                                                           The SAS System

61         
62         2011-05-08 DK  Error/no subjects in DM handling
63         
64         2011-06-02 DK  Modified the missing/0 lab test result data check to handle
65                        the case that there are no missing/0 lab test results
66                        Changed the denominators in the missing baseline lab test data check
67                        to the number of subjects per arm who had post-baseline lab tests
68                        Added ALKP to the list of values for ALP
69         
70         2011-06-03 DK  Made the liver lab test code data check mandatory; if any of the four
71                        lab tests is missing, the analysis is not done and an error is output
72         
73         2011-06-09 DK  Fixed a bug where splitting the lab tests into separate datasets
74                        was not using the macro variables defining the acceptable lab test codes
75         
76         2014-05-04 JP  Fixed bug where baseline results were being pulled into any visit. Should
77         			   be any visit besides baseline.
78         
79         2015-02-12 DC  Enhanced the panel to include USUBJID for Hy's Law
80         
81         2015-10-30 DC  Enhanced the panel to include additional information on multiple baseline
82                        Lab test that conflict in numeric results
83         
84         2015-12-03 PG  Modified the above enhancement to include all duplicate baseline tests
85         
86         */
87         
88         /* the minoperator option allows the use of the in operator by the macro language */
89         options minoperator;
90         options missing='';	
91         
92         /* determine the run location by looking for the SL-set run_location macro variable */
93         %sysfunc(ifc(not %symexist(run_location),%nrstr(%let run_location = local;),));
94         %put RUN LOCATION: &run_location.;
RUN LOCATION: local
95         
96         
97         %macro params;
98         
99         	/* program parameters if the program is run locally */
100        	%if %upcase(&run_location.) = LOCAL %then %do;
101        
102        		data macrovar; set sashelp.vmacro(keep=scope name where=(scope='GLOBAL' & name ne 'RUN_LOCATION')); run;
103        		data _null_; set macrovar; call execute('%symdel '||trim(left(name))||';');	run;
104        		proc datasets kill; quit;
105        
106        		%global panel_title panel_desc;
107        		%let panel_title = Liver Labs;
108        		%let panel_desc = ;
109        
110        		%global ndabla studyid;
111        		%let ndabla = ;
112        		%let studyid = ;
113        
114        		%let studypath = D:/meta_hackathon/sas2r-agent/data/derived/cdisc-pilot/sdtm;
115        
116        		libname folder "&studypath.";
117        
                                                           The SAS System

118        		data dm; set folder.dm; run;
119        		data lb; set folder.lb; run;
120        
121        		%global saspath utilpath;
122        		%let saspath = D:/meta_hackathon/sas2r-agent/programs/sas/macros/phuse-jumpstart;
123        		%let utilpath = D:/meta_hackathon/sas2r-agent/programs/sas/macros/phuse-jumpstart;
124        
125        		%let templatepath = D:/meta_hackathon/sas2r-agent/data/raw/phuse-templates;
126        		%let template = Liver_Labs_Template.xls;
127        
128        		%let outpath = &outds.;
129        		%let outfile = Liver_Labs.xls;
130        
131        		%global liverout errout;
132        		%let liverout = &outpath.\&outfile.;
133        		%let errout = &outpath.\Liver Labs Error Summary.xls;
134        
135        		/* copy template to output file */
136        		/* added by DK */
137        		options noxwait xsync;
138        
139        		x "%str(copy %"&templatepath.\&template.%" %"&liverout.%")";
140        
141        		/* dummy grouping, subsetting, and dataset information datasets */
142        		data sl_datasets;
143        			datatype = ''; name = ''; partition_variable = ''; default = '';
144        			delete;
145        		run;
146        		data sl_group;
147        			group_name = ''; domain = ''; partition = ''; var_name = ''; var_value = ''; dsvg_grp_name = '';
148        			delete;
149        		run;
150        		data sl_subset;
151        			name = ''; domain = ''; partition = ''; var_name = ''; var_value = ''; inner_operator = ''; outer_operator = '';
152        			delete;
153        		run;
154        
155        		proc printto print="&saspath.\liveroutput.lst"; run; quit;
156        
157        	%end;
158        
159        	/* program parameters if the program is run through Script Launcher */
160        	%else %do;
161        
162        		/* map the user-defined Script Launcher panel option values onto panel macro variables */
163        		data _null_;
164        		run;
165        
166        	%end;
167        
168        %mend params;
169        
170        %params;

