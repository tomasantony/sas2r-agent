83         
84         data adsl_pop;
85           merge adsl_trt(in=a) _saf(in=b);
86           by STUDYID USUBJID;
                                                           The SAS System

87           if a;
88           length ITTFL $1;
89           if missing(SAFFL) then SAFFL = "N";
90           if ARM in ("Placebo", "Xanomeline High Dose", "Xanomeline Low Dose")
91             then ITTFL = "Y";
92             else ITTFL = "N";
93         run;

