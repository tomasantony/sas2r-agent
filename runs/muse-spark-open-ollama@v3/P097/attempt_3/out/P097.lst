47         /* run t test for two independent samples;
48            save the statistics n1,n2,m1,m2,PooledSD */
49         %let DSName = scores;
                                                           The SAS System

50         %let Group = Gender;
51         %let Y = Score;
52         
53         proc ttest data=&DSName plots=none;
54            class &Group;
55            var &Y;
56            ods select Statistics;
57            ods output Statistics=TTestOut;
58         run;

WARNING: You must enable ODS graphics before requesting plots.
