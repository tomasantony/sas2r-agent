163        /* ------------------------------ 8. Efficacy flag from QS ------------- */
164        /* EFFFL = Y if SAFFL=Y AND >=1 post-baseline ACTOT score in QS. */
165        proc sql;
166          create table _eff as
167            select distinct USUBJID, "Y" as EFFFL length=1
168            from qs
169            where QSTESTCD = "ACTOT"
170              and QSCAT    = "ALZHEIMER'S DISEASE ASSESSMENT SCALE"
171              and not missing(QSSTRESN)
172              and upcase(VISIT) ne "BASELINE"
173              and not index(upcase(VISIT), "SCREENING");
