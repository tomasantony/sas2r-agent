3488       		   output;
3489       		 end;
3490       		 else do;
3491       		  do I = percent0 to percent-.01 by .01;
3492       		    percent2 = I;
3493       			subjects2 = 0;
3494       			output;
3495       		  end;
3496       		  percent2 = percent;
3497       		  subjects2 = subjects;
3498       		  output;
