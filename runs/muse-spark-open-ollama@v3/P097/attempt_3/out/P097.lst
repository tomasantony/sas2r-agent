1          /************************************************************************************************
2           RETAIN THE FIRST OBSERVATION IN EACH BY GROUP AND SAVE REMOVED ROWS
                                                           The SAS System

3               This program keeps only the first row for each unique value of a variable.
4               Keywords: PROC SORT, remove duplicates
5               SAS Versions: SAS 9, SAS Viya
6               Documentation:
6        ! https://documentation.sas.com/?cdcId=pgmsascdc&cdcVersion=default&docsetId=proc&docsetTarget=p1nd17xr6wof4sn19zkmid81p926
6        ! .htm
7               1. Create the WORK.CLASSTEST table and print it.
8               2. The first PROC SORT arranges rows by desending scores for each Name and Subject.
9               3. The second PROC SORT keeps only the first occurence of each Name and Subject combination.
10                 The DUPOUT= options saves rows that are removed in a separate table named CLASSTEST_DUPS.
11         ************************************************************************************************/
12         
13         data classtest;                                                       /*1*/
14            infile datalines dsd;
15            input
16               Name :$7.
17               Subject :$7.
18               Score;
19         datalines4;

