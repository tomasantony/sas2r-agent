7          
8          /*Part A*/
9          %macro mymac(dist,param1,param2=,n=100,stats=no,plot=no);
10         
11         /*Part B*/
12         %if &dist= %then %do;
13            %put Dist is a required argument;
14            %return;
15         %end;
16         
17         %if &param1= %then %do;
18            %put Param1 is a required argument;
19            %return;
20         %end;
21         
22         /*Part C*/
23         %if &param2= %then %do;
24            data random (drop=i);
25               do i=1 to &n;
26                  y=rand("&dist",&param1);
27         	     x+1;
28         	     output;
29               end;
30            run;
31         %end;
32         
33         %else %do;
34            data random (drop=i);
35               do i=1 to &n;
36                  y=rand("&dist",&param1,&param2);
37         	     x+1;
38         	     output;
39               end;
40            run;
41         %end;
42         
43         /*Part D*/
44         %if %upcase(&stats)=YES %then %do;
45            proc means data=random mean std;
46               var y;
47            run;
48         %end;
49         
50         /*Part E*/
51         %if %upcase(&plot)=YES %then %do;
52            proc sgplot data=random;
53               histogram y / binwidth=1;
54         	  density y / type=kernel;
55            run;
56         %end;
57         
58         %mend;
59         
60         /*Part F*/
                                                           The SAS System

