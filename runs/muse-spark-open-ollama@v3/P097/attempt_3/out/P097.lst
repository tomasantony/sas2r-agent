500          %macro TE_data(in, phase, out);
501            proc sort data=&in;
502        	 by id wks;
503        
504        	data &out;
505        	 set &in;
506        	 by id wks;
507        	 keep id trt &phase.min &phase.max &phase.lst;
508        	 retain &phase.min &phase.max;
509        	 if first.id then do;
510        	  &phase.min=lab_test_1;
511              &phase.max=lab_test_1;
512             end;
513        	 else do;
514        	  if &phase.min>lab_test_1 then &phase.min=lab_test_1;
515        	  if &phase.max<lab_test_1 then &phase.max=lab_test_1;
516        	 end;
517        	 if last.id then do;
518        	  &phase.lst=lab_test_1;
519        	  output;
520        	 end;
521        	Run;
522          %mend TE_data;
523          %TE_data(base, bse, bse);

