100           proc template;
101           define statgraph temp_pksum;
102           DYNAMIC _XMAX _YMAX _XLABEL _YLABEL _SD TICKS VIEW GSTAT _LEGENDSIZE;
103           MVAR SCALE1 SCALE2 TRTLBL ;
104           begingraph / designwidth=2500px designheight=1400px;
105           layout lattice / columns=2 rows=2 ROWWEIGHTS= (.9 .1) ;
106           cell;
107           cellheader;
108           entry "Linear view" / textattrs=(size=9pt) ;
109           endcellheader;
110           *layout for linear scale;
111           layout overlay /XAXISOPTS =( LABEL=_XLABEL LABELATTRS=GRAPHVALUETEXT(SIZE=10pt)
112                                        tickvalueattrs=(size=9) Linearopts=( viewmin=0 viewmax=_XMAX tickvaluelist=ticks
112      ! tickvaluefitpolicy=NONE))
113                           YAXISOPTS =(LABEL=_YLABEL LABELATTRS=GRAPHVALUETEXT(SIZE=10pt) tickvalueattrs=(size=9) Linearopts=(
113      ! viewmin=0 viewmax = _YMAX ));
114        
115           if (_SD = 'BOTH'  )
116        
117                scatterplot x=PCTPT y=PCMEAN / yerrorlower=eval(PCMEAN - PCSD)
118                      yerrorupper=eval(PCMEAN + PCSD) group=TRTAN MARKERATTRS=(color=black )
119                      yerrorupper=eval(PCMEAN + PCSD) group=TRTAN MARKERATTRS=(color=black ) name="s2" ;
120           seriesplot x=PCTPT y=PCMEAN /group=TRTAN LINEATTRS=(color=black) name="s1";
121        
122        				
123           endif;
124        
125           if (_SD = 'UPPER'  )
126                 scatterplot x=PCTPT y=PCMEAN /  yerrorlower=eval(PCMEAN)
127                                     yerrorupper=eval(PCMEAN + PCSD)
128                                     group=TRTAN MARKERATTRS=(color=black )
129                                     MARKERATTRS=(color=black ) name="s2" ;
130                 seriesplot x=PCTPT y=PCMEAN /group=TRTAN LINEATTRS=(color=black) name="s1";
131        		
