98            define manager / group
99                             format=$mgrfmt.;
100           define sector / group
101                           format=$sctrfmt.;
102           define sales / format=dollar11.2
103                          '';
104           define sum / format=dollar9.2
105                        'Total Sales';
106           define pctsum / 'Percent of Sales' format=percent6. width=8;
107           define comment / computed width=20 '' flow;
108           compute comment / char length=40;
109              if sales.pctsum gt .15 and _break_ = ' '
110              then comment='Sales substantially above expectations.';
111              else comment=' ';
112           endcomp;
113           rbreak after / ol summarize;
114        run;

