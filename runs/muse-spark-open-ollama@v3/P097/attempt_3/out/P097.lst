4406       			if (ALT_RES GE ALT_HI*3) then ALTx3 = 1;
4407       			if (ALT_RES GE ALT_HI*5) then ALTx5 = 1;
4408       			if (ALT_RES GE ALT_HI*10) then ALTx10 = 1;
4409       			if (ALT_RES GE ALT_HI*20) then ALTx20 = 1;
