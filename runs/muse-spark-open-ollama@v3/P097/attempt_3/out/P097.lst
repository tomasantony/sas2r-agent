14         %macro WaterFall_3D_Macro (
15                Data=, 		/*--Required - Data set name--*/
16                Duration=,	/*--Required - Treatment Duration variable--*/
17                Response=, 	/*--Required - Tumor Response variable--*/
18                Dropped=, 	/*--Required - Subjects dropped--*/
19                Group=,		/*--Required - Treatment Drug--*/
20                Code=, 		/*--Required - RECIST Code--*/
21                AttrMap=,	/*--Required - Attribute Map--*/
22                Lblx=X, 		/*--X-Axis (Front) Label--*/
23                Lbly=Y,		/*--Y-Axis (Horizontal plane) Label--*/
24                Lblz=Z,		/*--Z-Axis (Vertical) Label--*/
25                xFac=1,		/*--X-Axis scale factor--*/
26                Tilt=65,		/*--View Tilt 60 to 80--*/
27                Rotate=-55,	/*--View Rotation -15 to -75--*/
28                Title=		/*--Graph Title--*/
29         );
30         
31         /*--Check for Required Parameters   --*/
32         /*--Terminate if these required parameters are not supplied--*/
33         %if %length(&Data) eq 0 %then %do;
34         %put The parameter 'Data' is required - WaterFall 3D Macro Terminated.;
35         %goto finished;
36         %end;
37         
38         %if %length(&Duration) eq 0 %then %do;
39         %put The parameter 'Duration' is required - WaterFall 3D Macro Terminated.;
40         %goto finished;
41         %end;
42         
43         %if %length(&Response) eq 0 %then %do;
44         %put The parameter 'Response' is required - WaterFall 3D Macro Terminated.;
45         %goto finished;
46         %end;
47         
48         %if %length(&Dropped) eq 0 %then %do;
49         %put The parameter 'Dropped' is required - WaterFall 3D Macro Terminated.;
50         %goto finished;
51         %end;
52         
53         %if %length(&Group) eq 0 %then %do;
54         %put The parameter 'Group' is required - WaterFall 3D Macro Terminated.;
55         %goto finished;
56         %end;
57         
58         %if %length(&Code) eq 0 %then %do;
59         %put The parameter 'Code' is required - WaterFall 3D Macro Terminated.;
60         %goto finished;
                                                           The SAS System

61         %end;
