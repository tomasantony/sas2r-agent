583        
584            /* Ensure consistent ordering */
585            if SEX = 'M' then SEXN = 1;
586            else if SEX = 'F' then SEXN = 2;
587        
588            if RACE = 'WHITE' then RACEN = 1;
589            else if RACE = 'BLACK OR AFRICAN AMERICAN' then RACEN = 2;
590            else if RACE = 'ASIAN' then RACEN = 3;
591            else RACEN = 4;
592        
593            if ETHNIC = 'HISPANIC OR LATINO' then ETHNICN = 1;
594            else if ETHNIC = 'NOT HISPANIC OR LATINO' then ETHNICN = 2;
595            else ETHNICN = 3;
