107              data advs_sub;
108                set work.advs;
109                where (paramcd in ('DIABP') and atptn in (815 817));
110        
111                attrib trtp_short length=$6 label='Planned Treatment, abbreviated';
112        
113                select (trtp);
114                  when ('Placebo')              trtp_short = 'P';
115                  when ('Xanomeline High Dose') trtp_short = 'X-high';
116                  when ('Xanomeline Low Dose')  trtp_short = 'X-low';
117                  otherwise                     trtp_short = 'UNEXPECTED';
118                end;
119              run;

