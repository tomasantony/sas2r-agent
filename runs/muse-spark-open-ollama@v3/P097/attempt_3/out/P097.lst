4159       		%put BASELINE FLAG DOES NOT EXIST ... CREATING BASELINE FLAG;
4160       
4161       		data labdata1;
4162       		set labdata;
4163       		if lbdy le 1 then a = lbdy;
4164       		run;
4165       
4166       		proc sort data = labdata1;
4167       		by usubjid descending a ;
4168       		run;
4169       
4170       		data bl;
