3933       /**********************************/
3934       /* RUN DISPOSITION ANALYSIS PANEL */
3935       /**********************************/
3936       %macro ds;
3937       
                                                           The SAS System

3938       	%ds_prelim_check;
3939       
3940       	%if &dm_subj_gt0. and &all_req_var. %then %do;
3941       
3942       		%ds_setup;
3943       
3944       		%ds_by_arm(dm_ds,final_dispositionA);
3945       
3946       		%ds_by_arm(dm_ds_ex,final_dispositionB);
3947       
3948       		%time_to_event(dm_ds);
3949       
3950       		%time_to_event(dm_ds_ex);
3951       
3952       		/* do preprocessing of Script Launcher datasets */
3953       		%group_subset_pp;
3954       
3955       		%ds_out;
3956       
3957       		/* data checks */
3958       		%disposition_check;
3959       
3960       		%disposition_check_out;
3961       
3962       		/* create grouping & subsetting output */
3963       		%group_subset_xls_out(gs_file=&dispout.);
3964       
3965       	%end;
3966       	%else %do;
3967       		%error_summary(err_file=&errout.,
3968                              err_nosubj=%sysfunc(ifc(&dm_subj_gt0.,0,1)),
3969                              err_missvar=%sysfunc(ifc(&all_req_var.,0,1))
3970                              );
3971       	%end;
3972       
3973       %mend ds;
