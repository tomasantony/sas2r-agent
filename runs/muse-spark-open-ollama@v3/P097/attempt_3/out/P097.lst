4009       	%macro find_null_col(inlib, dsn, outlib);
4010       		options nofmterr;
4011       		/*obtain metadata information*/
4012       		ods listing close;
4013       		ods output variables=varlist(keep=member variable);
4014       
4015       		proc datasets library=%upcase(&inlib) memtype=data;
4016       		contents data=_all_;
4017       		quit;
4018       		run;
4019       
4020       		ods output close;
4021       		ods listing;
4022       
4023       		data varlist(keep=member variable rename=(member=name));
4024       			set varlist;
4025       			member=compress(tranwrd(member,%upcase("&inlib.."),''));
4026       		run;
4027       
4028       		/*count non-missing values for each column*/
4029       		data _null_;
4030       			set varlist end=t;
4031       			%if &dsn ne %then %do; where compress(name)=%upcase("&dsn"); %end;
4032       			call execute(
4033       			"proc sql; create table ds" || compress(put(_n_,best.))
4034       			|| " as select count(" || compress(variable)
                                                           The SAS System

4035       			|| ") as cnt, '" || compress(name) || "' as dataset length=100,'"
4036       			|| compress(variable) || "' as variable length=100 from &inlib.."
4037       			|| compress(name) || " where "
4038       			|| compress(variable) || " is not missing; quit;"
4039       			);
4040       			if t then call symput("cnt",compress(put(_n_,best.)));
4041       		run;
4042       
4043       		/*identify columns with all missing values*/
4044       		data rpt;
4045       			set
4046       			%do index=1 %to &cnt; ds&index %end; ;
4047       			where cnt=0;
4048       			;
4049       		run;
4050       
4051       		proc sql noprint;
4052       			select count(*) into: nvar from rpt;
4053       		quit;
4054       
4055       		/*print list file*/
4056       		title1 "LIST OF COLUMNS WITH MISSING VALUES IN LIBRARY %UPCASE(&INLIB)";
4057       		%if &dsn ne %then %do; title2 "FOR DATASET %UPCASE(&DSN)"; %end;
4058       		%if &nvar = 0 %then %do;
4059       			data rpt;
4060       				msg=" There are no columns with missing values.";
4061       				output;
4062       			run;
4063       
4064       			proc print data=rpt noobs;
4065       			run;
4066       		%end;
4067       
4068       		%else %do;
4069       			proc print data=rpt noobs;
4070       			var dataset variable;
4071       			run;
4072       		%end;
4073       		/*output datasets*/
4074       		%if (&outlib ne ) and &nvar. > 0 %then %do;
4075       
4076       			%if &outlib. ne work %then %do;
4077       				proc datasets nolist memtype=data;
4078       					copy in=&inlib out=&outlib;
4079       					%if &dsn ne %then %do; select &dsn; %end;
4080       				quit;
4081       				run;
4082       			%end;
4083       
4084       			data _null_;
4085       				length varlist $1000;
4086       				retain varlist;
4087       				set rpt;
4088       				by dataset;
4089       				if first.dataset then varlist='';
4090       				varlist=left(trim(varlist)) || ' ' || trim(variable);
4091       				if last.dataset then
4092       				call execute(
                                                           The SAS System

4093       				"data &outlib.." || compress(dataset) || "(drop=" || trim(varlist)
4094       				|| ");" || "set &outlib.." || compress(dataset)
4095       				|| ";" || "run;"
4096       				);
4097       			run;
4098       
4099       		%end;
4100       		title1; title2;
4101       		quit;
4102       		run;
4103       
4104       	%mend find_null_col;
4105       
4106       	%find_null_col(work, labdata, work);
