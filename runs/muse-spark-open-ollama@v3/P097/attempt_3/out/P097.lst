1          /****************************************************************************/
2          /*         PROGRAM NAME: Exposure Analysis Panel                            */
                                                           The SAS System

3          /*                                                                          */
4          /*          DESCRIPTION: Does an analysis of the exposure events for        */
5          /*                        subjects in the study                             */
6          /*                                                                          */
7          /*      EVALUATION TYPE: Safety                                             */
8          /*                                                                          */
9          /*               AUTHOR: Andreas Anastassopoulos                            */
10         /*                          (andreas.anastassapoulos@us.ibm.com)            */
11         /*                                                                          */
12         /*                 DATE: March 16, 2010                                     */
13         /*                                                                          */
14         /*  EXTERNAL FILES USED: Exposure_Template.xls -- Excel template            */
15         /*                       data_checks_exposure.sas -- EX data checks         */
16         /*                       exposure_exdosfrq.csv -- dose frequency codes      */
17         /*                       data_checks.sas -- Generic variable checks         */
18         /*                       sl_gs_output.sas -- Script Launcher settings output*/
19         /*                       err_output.sas -- Error output when missing vars   */
20         /*                                                                          */
21         /*  PARAMETERS REQUIRED: saspath -- location of external panel SAS programs */
22         /*                       utilpath -- location of external util SAS programs */
23         /*                       dosfrqpath -- location of the EXDOSFRQ code list   */
24         /*                       ndabla -- NDA or BLA number                        */
25         /*                       studyid -- study number                            */
26         /*                                                                          */
27         /*                       studypath -- location of the drug study datasets   */
28         /*                       outpath -- location of the output                  */
29         /*                       outfile -- filename of the output                  */
30         /*                       templatepath -- location of the Excel template     */
31         /*                       template -- filename of the template               */
32         /*                                                                          */
33         /*   VARIABLES REQUIRED: DM -- ACTARM or ARM                                */
34         /*                             RFSTDTC                                      */
35         /*                             USUBJID                                      */
36         /*                       EX -- USUBJID                                      */
37         /*                             EXENDTC or EXSTDTC                           */
38         /*                                                                          */
39         /* OTHER VARIABLES USED: DM -- ARMCD                                        */
40         /* IF AVAILABLE          EX -- EXTRT                                        */
41         /*                             EXDOSE                                       */
42         /*                             EXDOSU                                       */
43         /*                             EXDOSFRQ                                     */
44         /*                             EXDOSFRM                                     */
45         /*                             EXADJ                                        */
46         /*                                                                          */
47         /*            MADE WITH: SAS 9.2                                            */
48         /*                                                                          */
49         /*                NOTES:                                                    */
50         /*                                                                          */
51         /****************************************************************************/
52         
53         /* REVISIONS */
54         /*
55         ** 8/10 changes includes adding the study day and the reason to dose changes  ***;
56         ** 8/11 changes include making cummulative dose graph as percent of total doses instead of number **;
57         ** 8/16 changes the cummulative dose to make it a continuous graph ***;
58         ** 8/18 changes the SCHEDULED vs ACTUAL  **;
59         ** 8/24 changes the verbiage of the ARM in dose graph ***;
60         
                                                           The SAS System

61         2011-02-29  DK  Added exposure dose frequency lookup
62                         Changed template and output method
63         
64         2011-03-05  DK  Added grouping & subsetting output
65         
66         2011-03-27  DK  Added run location handling
67         
68         2011-04-26  DK  Fixed planned arm in planned arm vs actual arm when ACTARM is present
69         
70         2011-05-08  DK  Error/no subjects in DM handling
71         
72         2011-06-09  DK  Fixed a bug where the hash table in the EX_DM merge would fail to initialize
73                         because the first observation was not a match by adding a count of matches
74         */
75         
76         /* the minoperator option allows the use of the in operator by the macro language */
77         options minoperator;
78         options missing='';	
79         
80         /* determine the run location by looking for the SL-set run_location macro variable */
81         %sysfunc(ifc(not %symexist(run_location),%nrstr(%let run_location = local;),));
82         %put RUN LOCATION: &run_location.;
RUN LOCATION: local
83         
84         %macro params;
85         
86         	/* program parameters if the program is run locally */
87         	%if %upcase(&run_location.) = LOCAL %then %do;
88         
89         		data macrovar; set sashelp.vmacro(keep=scope name where=(scope='GLOBAL' & name ne 'RUN_LOCATION')); run;
90         		data _null_; set macrovar; call execute('%symdel '||trim(left(name))||';');	run;
91         		proc datasets kill; quit;
92         
93         		%global panel_title panel_desc;
94         		%let panel_title = Exposure;
95         		%let panel_desc = ;
96         
97         		/* NDA/BLA number */
98         		/* study number */
99         		%global ndabla studyid;
100        		%let ndabla = ;
101        		%let studyid = ;
102        
103        		/* location of the study being examined */
104        		%let studypath = D:/meta_hackathon/sas2r-agent/data/derived/cdisc-pilot/sdtm;
105        
106        		libname path "&studypath.";
107        
108        		/* retrieve datasets */
109        		data dm; set path.dm; run;
110        		data ex; set path.ex; run;
111        
112        		/* location of external SAS programs */
113        		%global saspath utilpath;
114        		%let saspath = D:/meta_hackathon/sas2r-agent/programs/sas/macros/phuse-jumpstart;
115        		%let utilpath = D:/meta_hackathon/sas2r-agent/programs/sas/macros/phuse-jumpstart;
116        
117        		/* read in the list of dose frequencies from the CSV file */
                                                           The SAS System

118        		%global dosfrqpath;
119        		%let dosfrqpath = D:/meta_hackathon/sas2r-agent/programs/sas/macros/phuse-jumpstart;
120        
121        		/* location and filename of the exposure panel template */
122        		%let templatepath = D:/meta_hackathon/sas2r-agent/data/raw/phuse-templates;
123        		%let template = Exposure_Template.xls;
124        
125        		/* location and filename of the output */
126        		%let outpath = &outds.;
127        		%let outfile = Exposure.xls;
128        
129        		%global expout errout;
130        		%let expout = &outpath.\&outfile.; 	
131        		%let errout = &outpath.\Exposure Error Summary.xls;
132        
133        		options noxwait xsync;
134        
135        		/* copy the template to the output file */
136        		x "%str(copy %"&templatepath.\&template.%" %"&expout.%")";
137        
138        		/* dummy grouping, subsetting, and dataset information datasets */
139        		data sl_datasets;
140        			datatype = ''; name = ''; partition_variable = ''; default = '';
141        			delete;
142        		run;
143        		data sl_group;
144        			group_name = ''; domain = ''; partition = ''; var_name = ''; var_value = ''; dsvg_grp_name = '';
145        			delete;
146        		run;
147        		data sl_subset;
148        			name = ''; domain = ''; partition = ''; var_name = ''; var_value = ''; inner_operator = ''; outer_operator = '';
149        			delete;
150        		run;
151        
152        	%end;
153        
154        	/* program parameters if the program is run through Script Launcher */
155        	%else %do;
156        
157        		%global dosfrqpath;
158        		%let dosfrqpath = &saspath.;
159        
160        		/* map the user-defined Script Launcher panel option values onto panel macro variables */
161        		data _null_;
162        		run;
163        
164        	%end;
165        
166        %mend params;
167        
168        %params;

