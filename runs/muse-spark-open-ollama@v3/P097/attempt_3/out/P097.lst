4121       	/*Code to check if variables exist*/
4122       	data null ;
4123       		dsid=open('labdata');
4124       		check_visitnum = varnum(dsid,'visitnum');
4125       		check_basflag = varnum(dsid,'lbblfl');
4126       		check_lbdy = varnum(dsid,'lbdy');
4127       		call symput ('chk_blfl',put(check_basflag,3.));
4128       		call symput ('chk_vnum',put(check_visitnum,3.));
4129       		call symput ('chk_lbdy',put(check_lbdy,5.));
4130       	run;
4131       
4132       	/* if variable is not part of dataset, create the variable*/
4133       	%if &chk_lbdy. = 0 %then %do;
4134       
4135       		%put LAB DAY DOES NOT EXIST ... CREATING LAB DAY;
4136       
4137       		data labdata;
4138       			set labdata;
4139       			/*create study days*/
4140       			treatdate = input(LBDTC, yymmdd10.);
4141       			studydate = input(RFSTDTC, yymmdd10.);
4142       			enddate = input(LBDY, 5.);
4143       
4144       			if enddate = . then do;
4145       			  if treatdate >= studydate then lbdy = (treatdate - studydate)+1;
4146       			    else lbdy = (treatdate - studydate);
4147       			end;
4148       			else do;
4149       			if enddate >= studydate then lbdy = (enddate - studydate)+1;
4150       			  else lbdy = (enddate - studydate);
                                                           The SAS System

4151       			end;
4152       		run;
4153       
4154       	%end;
4155       
4156       
4157       	%if &chk_blfl. = 0 %then %do; /*create baseline flag*/
