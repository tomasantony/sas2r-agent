      Step Count                        2  Switch Count  0
      

75         ;
76         run;
77         
78         /**********FORMATS********************************************/
79         
80         proc format;
81         value $agef '0'='< 1' '1'='1-4' '5'='5-9'  '10'='10-14'  '15'='15-19'  '20'='20-24'  '25'='25-29'  '30'='30-34'
82         				'35'='35=39'  '40'='40-44'  '45'='45-49' '50'='50-54'  '55'='55-59' '60'='60-64'  '65'='65-69'
83         				'70'='70-74' '75'='75+';
NOTE: Format $AGEF has been output.
84         value $sexf 'at'='All Texas'
85         			'bt'='All Blacks'
86         			'ht'='All Hispanics'
87         			'wt'='All Whites**'
88         			'ft'='All Females'
89         			'mt'='All Males'
90         			'bf'='Black Females'
91         			'bm'='Black Males'
