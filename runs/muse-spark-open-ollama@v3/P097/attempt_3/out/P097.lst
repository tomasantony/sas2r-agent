4821       		%dili3 (Alanine Aminotransferase, ALT);
4822       		%dili3 (Aspartate Aminotransferase, AST);
4823       		%dili3 (Total Bilirubin, BILI);
4824       		%dili3 (Alkaline Phosphatase, ALP);
4825       
4826       		%macro dili4(lab);
4827       			%do k = 1 %to 5;
4828       				data &lab._arm&i._blmax&k.;
4829       					retain lab;
4830       					merge &lab._arm&i._bl1_mx&k. &lab._arm&i._bl2_mx&k. &lab._arm&i._bl3_mx&k. &lab._arm&i._bl4_mx&k.
4830     ! &lab._arm&i._bl5_mx&k.;
4831       					by lab;
4832       				run;
4833       
4834       			%end;
4835       		%mend dili4;
4836       
4837       		%dili4(ALT);
4838       		%dili4(AST);
4839       		%dili4(BILI);
4840       		%dili4(ALP);
4841       
4842       
4843       		%macro dili5(lab);
4844       			data &lab._arm&i._blmax;
4845       				retain lab;
                                                           The SAS System

4846       				merge &lab._arm&i._blmax1 &lab._arm&i._blmax2 &lab._arm&i._blmax3 &lab._arm&i._blmax4 &lab._arm&i._blmax5;
4847       				by lab;
4848       				rename bl1_count = bl1_count_arm&i.
4849       						bl1_percent = bl1_percent_arm&i.
4850       						bl2_count = bl2_count_arm&i.
4851       						bl2_percent = bl2_percent_arm&i.
4852       						bl3_count = bl3_count_arm&i.
4853       						bl3_percent = bl3_percent_arm&i.
4854       						bl4_count = bl4_count_arm&i.
4855       						bl4_percent = bl4_percent_arm&i.
4856       						bl5_count = bl5_count_arm&i.
4857       						bl5_percent = bl5_percent_arm&i.;
4858       			run;
4859       
4860       		%mend dili5;
4861       
4862       		%dili5(ALT);
4863       		%dili5(AST);
4864       		%dili5(BILI);
4865       		%dili5(ALP);
4866       
4867       		/*dataset for ast/alt and tb max values comparison*/
4868       
4869       		data ast_bili_max_arm&i.;
4870       			merge ast_max_arm&i. (in=a) bili_max_arm&i. (in=b);
4871       			by usubjid;
4872       			drop usubjid;
4873       		run;
4874       
4875       		data alt_bili_max_arm&i.;
4876       			merge alt_max_arm&i. (in=a) bili_max_arm&i. (in=b);
4877       			by usubjid;
4878       			drop usubjid;
4879       		run;
4880       
4881       	%end;
4882       
4883       %mend liver_arm;
