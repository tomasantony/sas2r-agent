24         ELSE IF TRT="Placebo" THEN VIS=VISIT+0.15;
25         ELSE IF TRT="AC" THEN VIS=VISIT+0.30;
26         
27         IF VISIT IN (4,5) THEN VIS=VIS-0.15;
