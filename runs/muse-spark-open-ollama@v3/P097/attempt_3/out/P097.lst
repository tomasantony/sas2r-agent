1          DATA X;
2          LENGTH TRT $10.;
3          DO TRT="Study Drug","Placebo","AC";
4          
5          DO J= 1 TO 10;
6          
7          SUBJID=J+100*(TRT="Study Drug")+200*(TRT="Placebo")+300*(TRT="AC");
8          
9          DO VISIT=3 TO 6;
10         
11         X=ROUND(J+2*NORMAL(777),0.1);
12         OUTPUT;
13         END;
14         END;
15         END;
16         DROP J;
17         RUN;

