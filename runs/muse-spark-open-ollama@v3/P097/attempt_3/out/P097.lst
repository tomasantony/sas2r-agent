210        
211            options nocenter mautosource mrecall mprint msglevel=I mergenoby=WARN ls=max ps=max;
212        
213            %let ana_variables = STUDYID USUBJID &p_fl &a_lastfl &a_minfl &a_maxfl &t_var &tn_var PARAM PARAMCD &m_var &c_var &b_var &lo_var &hi_var &visitn &timepoint &timepointn;
214        
215            %*--- Global boolean symbol CONTINUE, used with macro assert_continue(), warns user of invalid environment. Processing should HALT. ---*;
216              %let CONTINUE = %assert_depend(OS=%str(AIX,WIN,HP IPF),
217                                             SASV=9.4M2,
218                                             SYSPROD=,
219                                             vars=%str(&m_lb..&m_ds : &ana_variables),
