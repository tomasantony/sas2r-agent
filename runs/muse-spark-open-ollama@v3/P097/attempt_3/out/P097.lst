4188       	%end;
4189       
4190       	%if &chk_vnum. = 0 %then %do; /* create visitnum*/
4191       
4192       		%put VISIT NUMBER DOES NOT EXIST ... CREATING VISIT NUMBER;
4193       
4194       		proc freq data = labdata noprint;
4195       		table lbdy/out = studydays;
