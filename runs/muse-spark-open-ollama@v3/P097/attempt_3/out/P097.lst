1          /*This is for the Life Tables for the Texas Vital Statistics Annual Report Table 24*/
2          
                                                           The SAS System

3          /*started by A. Vincent 11/15/2016*/
4          /*some information from a very old SAS paper named "SAS Macros for Generating Abridged and Cause-Eliminated Life
4        ! Tables"*/
5          /*by Zhao Yang, Xuezheng Sun. */
6          /******************************************************************************************************/
7          
8          /*put in the year that is needed for the final output*/
9          %let year=2014;
10         /*the #byval() prints the values of the column in the by group section of the report*/
11         %let title1="Abridged Life Tables*** for AR Table 24 by #byval(sexRace) for &year";
12         /*footnotes can be added or not depending on how you use the output report*/
13         %let footnote1="*Life expectancy at birth.";
14         %let footnote2="**Includes other and unknown race/ethnicity.";
15         %let footnote3="Life tables prepared using SAS.";
16         %let footnote4="See Technical Appendix for Life Table Construction.";
17         
18         /*this can imputted in the order below. There should only be one space between columns*/
19         /*of course one can change the space to any delimiter.*/
20         data tests;
21            length sexRace $2. years agegroup population deaths births ax 8.;
22            input sexRace $ years agegroup population deaths births ax ;
23            datalines;

NOTE: The data set WORK.TESTS has 51 observations and 7 variables.
