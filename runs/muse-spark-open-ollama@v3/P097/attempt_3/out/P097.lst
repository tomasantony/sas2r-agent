4730       		%macro dili3(test, lab);
                                                           The SAS System

4731       
4732       			%put DILI MACRO, &test. (&lab.);
4733       
4734       			/* moved out from inside the loop below */
4735       			data dili_blmax_arm&i.;
4736       				set dili_blmax_arm&i.;
4737       				%do j = 1 %to 5;
4738       					%do k = 1 %to 5;
4739       
4740       						if bllab_&j. = 1 & maxlab_1 = 1 then bl&j._mx1 = 1;
4741       						if bllab_&j. = 1 & maxlab_2 = 1 then bl&j._mx2 = 1;
4742       						if bllab_&j. = 1 & maxlab_3 = 1 then bl&j._mx3 = 1;
4743       						if bllab_&j. = 1 & maxlab_4 = 1 then bl&j._mx4 = 1;
4744       						if bllab_&j. = 1 & maxlab_5 = 1 then bl&j._mx5 = 1;
4745       
4746       					%end;
4747       				%end;
4748       			run;
4749       
4750       			%do j = 1 %to 5;
4751       				%do k = 1 %to 5;
4752       
4753       					%put &test. BASELINE LAB &j. MAX LAB &k.;
4754       
4755       					proc freq data = dili_blmax_arm&i. noprint;
4756       					table bl&j._mx&k./out = &lab._arm&i._bl&j._mx&k.;	
4757       					where LBTEST in ("&test.") and bl&j._mx&k. = 1;
4758       					run;
4759       
4760       					data &lab._arm&i._bl&j._mx&k.;
4761       						length lab $10.;
4762       						set &lab._arm&i._bl&j._mx&k.;
4763       						rename count = bl&j._count
4764       							   percent = bl&j._percent;
4765       						percent = (count/&&dnom&i.)*100;
4766       						label count = " ";
4767       						label percent = " ";
4768       						lab = "&lab._mx&k.";
4769       						drop bl&j._mx&k.;
4770       					run;
4771       
4772       					proc sql noprint;
4773       					  select count(*) into: num_obs
4774       					  from &lab._arm&i._bl&j._mx&k.;
