127        /* ------------------------------ 6. Age groups + numeric codes -------- */
128        data adsl_age;
129          set adsl_disp;
130          length AGEGR1 $6;
131          if AGE < 65 then do;
132            AGEGR1 = "<65";  AGEGR1N = 1;
133          end;
134          else if AGE >= 65 and AGE <= 80 then do;
135            AGEGR1 = "65-80"; AGEGR1N = 2;
136          end;
137          else if AGE > 80 then do;
138            AGEGR1 = ">80";   AGEGR1N = 3;
139          end;
140        
141          if SEX = "M" then SEXN = 1;
142          else if SEX = "F" then SEXN = 2;
143        
144          if RACE = "WHITE"                                    then RACEN = 1;
145          else if RACE = "BLACK OR AFRICAN AMERICAN"           then RACEN = 2;
146          else if RACE = "ASIAN"                               then RACEN = 3;
                                                           The SAS System

147          else if RACE = "AMERICAN INDIAN OR ALASKA NATIVE"    then RACEN = 4;
148          else if RACE = "NATIVE HAWAIIAN OR OTHER PACIFIC ISLANDER"
149                                                               then RACEN = 5;
150          else if RACE = "MULTIPLE"                            then RACEN = 6;
151        run;

