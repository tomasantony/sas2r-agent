4032       /*******************************/
4033       /* RUN EXPOSURE ANALYSIS PANEL */
4034       /*******************************/
4035       %macro ex;
4036       
4037       	/* preliminary data checks to ensure that required variables are present */
4038       	%ex_prelim_check;
4039       
4040       	/* only run the analysis if all required variables are present */
4041       	%if &dm_subj_gt0. and &all_req_var. %then %do;
4042       
4043       		%ex_setup;
4044       
4045       		%ex_1;
4046       		%ex_2;
4047       		%ex_3;
4048       		%ex_4;
4049       		%ex_5;
4050       
4051       		%group_subset_pp;
4052       
4053       		%ex_out;
4054       
4055       		/* run exposure panel data checks & output */
4056       		%exposure_check;
4057       
4058       		%exposure_check_out;
4059       
4060       		%group_subset_xls_out(gs_file=&expout.);
4061       
4062       	%end;
4063       	%else %do;
4064       		%error_summary(err_file=&errout.,
4065                              err_nosubj=%sysfunc(ifc(&dm_subj_gt0.,0,1)),
4066                              err_missvar=%sysfunc(ifc(&all_req_var.,0,1))
4067                              );
4068       	%end;
4069       
4070       %mend ex;
