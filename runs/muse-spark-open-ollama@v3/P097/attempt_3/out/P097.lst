112        /* Annoraw is the annotate data for the display of out of normal
112      ! limit data
113         * In real use, if lab_test_1>9 or .<lab_test_1<5.5 need to be
113      ! replaced with
114         * if lab_test_1>ULN or .<lab_test_1<LLN
115         */
116        
117        data annoraw;
118         set bse_pst;
119         length function $8;
120         retain function color text size xsys ysys when;
121         if result>9 or .<result<5.5;
122         if result>9 then TE_High=1;
123         else TE_High=0;
124         if result<5.5 then TE_low=1;
125         else TE_low=0;
126          When='A'; /*'A' indcates the symbol will be draw after the plot
126      ! procedure
127                     'A' means the annote symbol is in the front of the plot
128                     'B' indcates the symbol will be draw before the plot
128      ! procedure
129                     'B' means the annote sumbol is at the back of the plot
130                    */
131         xsys='2'; /* xsys= specifies a value that represents a coordinate
131      ! system.
132                      '2' means the Coordinate System Unit = data values */
133         ysys='2';
134         color = "red ";
135         function = "symbol "; * create a symbol;
136         text = "dot "; * (a filled circle);
137         size = 0.5;
138         x=point;
139         y=result;
140        run;

