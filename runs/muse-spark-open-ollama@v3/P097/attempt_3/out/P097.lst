3569       		%put &treatment2.;
3570       
3571       		data by_doses_percs&N.;
3572       		  set by_doses_percs;
3573       
3574       		if arm = "&treatment.";
3575       		cum_percent&N. = cum_percent;
3576       		percent= round(percent,.01);
3577       		label cum_percent&N = "&treatment2.";
3578       		arm&N = arm;
3579       
3580       		keep percent cum_percent&N. ;
3581       		run;
3582       
3583       	%end;
3584       
3585       
3586       	** MERGE BACK ALL THE DATASETS ***;
3587       
3588       	data final_ExposureB;
3589       		merge
3590       		%do S = 1 %to &num_treatments;
3591       		  by_doses_percs&S.
3592       		%end;
3593       		;
3594       		by percent;
3595       	run;
3596       
3597       %mend ex_2;
3598       
3599       
3600       /********************/
3601       /* BOXPLOT OF DOSES */
3602       /********************/
3603       %macro ex_3;
3604       
3605       	%put ***********************************;
3606       	%put * 3. ANALYSIS C: BOXPLOT OF DOSES *;	
3607       	%put ***********************************;
3608       
3609       	** NOW DO THE DOSE STATS ***;
3610       
3611       
3612       	** GET THE DESCRIPTIVE STATS BY ARM ***;
3613       
3614       	proc univariate data = by_usubjid (where=(doses >= 0)) noprint;
3615       	  class arm;
                                                           The SAS System

3616       	  var doses;
3617       	  output out = final_stats n=n_subjects std=sd_doses mean=mean_doses min=min_doses max=max_doses
3618       	                                                 median=median_doses q1=q1_doses q3=q3_doses mode=mode_doses
3619       	                                                 p10=p10_doses p90=p90_doses;
3620       	run;
3621       
3622       	** DETERMINE THE NUMBER OF ARMS ***;
3623       	%global num_arms;
3624       	proc sql noprint;
3625       	  select count(*) into: num_arms
3626       	  from final_stats;
3627       	quit;
3628       
3629       
3630       	%do I = 1 %to &num_arms.;
3631       
3632       		data _null_;
3633       		  set final_stats;
3634       		  if _N_ = &I;
3635       		  call symput('arm',arm);
3636       		  call symput('arm_2',compress(arm,'.'));
3637       		run;
3638       
3639       		** TRANSFORM THE DATA TO VERTICAL **;
3640       		data arm&I.(keep = sort_order arm&I.);
3641       			  set final_stats;
3642       			  format sort_order $20.;
3643       			if arm = "&arm.";
3644       			label arm&I. = "&arm_2.";
3645       
3646       			sort_order = '01 Mean';
3647       			arm&I. = mean_doses;
3648       			output;
3649       			sort_order = '02 SD';
3650       			arm&I. = sd_doses;
3651       			output;
3652       			sort_order = '03 Median';
3653       			arm&I. = median_doses;
3654       			output;
3655       			sort_order = '04 P10';
3656       			arm&I. = p10_doses;
3657       			output;
3658       			sort_order = '05 Q1';
3659       			arm&I. = q1_doses;
3660       			output;
3661       			sort_order = '06 Q3';
3662       			arm&I. = q3_doses;
3663       			output;
3664       			sort_order = '07 P90';
3665       			arm&I. = p90_doses;
3666       			output;
3667       			sort_order = '08 Min';
3668       			arm&I. = min_doses;
3669       			output;
3670       			sort_order = '09 Max';
3671       			arm&I. = max_doses;
3672       			output;
3673       			sort_order = '10 Median-P10';
                                                           The SAS System

3674       			arm&I. = median_doses-p10_doses;
3675       			output;
3676       			sort_order = '11 Q1';
3677       			arm&I. = q1_doses;
3678       			output;
3679       			sort_order = '12 Median - Q1';
3680       			arm&I. = median_doses-q1_doses;
3681       			output;
3682       			sort_order = '13 Q3 - Median';
3683       			arm&I. = q3_doses-median_doses;
3684       			output;
3685       			sort_order = '14 P90 - Median';
3686       			arm&I. = p90_doses-median_doses;
3687       			output;
3688       			sort_order = '15 Q1 - Min';
3689       			arm&I. = q1_doses-min_doses;
3690       			output;
3691       			sort_order = '16 Max - Q3';
3692       			arm&I. = max_doses-q3_doses;
3693       			output;
3694       			sort_order = '17 N';
3695       			arm&I. = n_subjects;
3696       			output;
3697       			sort_order = '18 Mode';
3698       			arm&I. = mode_doses;
3699       			output;
3700       		run;
3701       
3702       		proc sort data = arm&I.;
3703       		  by sort_order;
3704       		run;
3705       
3706       	%end;
3707       
3708       
3709       	data final;
3710       	  merge arm:;
3711       	  by sort_order;
3712       	run;
3713       
3714       	data for_macro;
3715       		format a $4.;
3716       		do I = 1 to &num_arms.;
3717       		a = compress("arm"||compress(I));
3718       		output;
3719       		end;
3720       	run;
3721       
3722       	proc sql noprint;
3723       	  select a into: arms separated by ','
3724       	  from for_macro;
3725       	quit;
3726       
3727       	proc sql;
3728       	  create table final_exposureC
3729       	  as select sort_order, &arms.
3730       	  from 	final;
3731       	quit;
                                                           The SAS System

3732       
3733       %mend ex_3;
3734       
3735       
3736       /****************************************************/
3737       /* CREATE THE PLANNED ARM VS ACTUAL TREATMENT TABLE */
3738       /****************************************************/
3739       %macro ex_4;
3740       
3741       	%put ************************************;
3742       	%put * 4. ANALYSIS D: PLANNED VS ACTUAL *;	
3743       	%put ************************************;
3744       
3745       	/* EXTRT, EXDOSE, and EXDOSU must exist to run this analysis */
3746       	%if &dm_arm. and &ex_extrt. and &ex_exdose. and &ex_exdosu. %then %do;
3747       
3748       		proc sql noprint;
3749       			/* find out how many subjects there were per planned arm */
3750       			create table ex_d_planned as
3751       			select arm, count(distinct usubjid)	as arm_count
3752       			from (select a.usubjid,
3753                                %if &dm_actarm. %then plannedarm;
3754       						 %else arm;	as arm
3755       			      from dm a,
3756       				       ex b
3757       				  where a.usubjid = b.usubjid)
3758       			group by arm;
3759       
3760       			/* find the number of subjects per treatment and dose */
3761       			create table ex_d_actual as
3762       			select arm, extrt, exdose, exdosu, count(distinct usubjid) as extrt_count
3763       			from (select a.usubjid,
3764                                %if &dm_actarm. %then plannedarm;
3765       	                     %else arm; as arm,
3766                                extrt, exdose, exdosu
3767       			      from ex a,
3768       				       dm b
3769       		          where a.usubjid = b.usubjid)
3770       			group by arm, extrt, exdose, exdosu;
3771       
3772       			/* combined the planned and actual counts */
3773       			create table ex_d_pva as
3774       			select a.arm, arm_count, extrt, exdose, exdosu, extrt_count
3775       			from ex_d_planned a,
3776       			     ex_d_actual b
3777       			where a.arm = b.arm
3778       			order by arm, extrt, exdose, exdosu;
3779       		quit;
3780       
3781       		/* format the planned vs. actual table for output */
3782       		data final_exposureD;
3783       			retain arm arm_count actual actual_dose actual_count;
3784       			set ex_d_pva;
3785       			by arm extrt exdose;
3786       
3787       			if not first.arm then do;
3788       				arm = '';
3789       				arm_count = .;
                                                           The SAS System

3790       			end;
3791       
3792       			if not first.extrt then extrt = '';
3793       
3794       			extrt = propcase(extrt);
3795       
3796       			length actual $100 actual_dose $100;
3797       			actual = extrt;
3798       			actual_dose = left(ifc(not missing(exdose),compress(exdose),'')||' '||
3799       		                  ifc(not missing(exdosu),exdosu,''));
3800       			actual_count = extrt_count;
3801       
3802       			keep arm arm_count actual actual_dose actual_count;
3803       		run;
3804       
3805       	%end;
3806       	/* if the variables necessary for this table don't exist, create an error message */
3807       	%else %do;
3808       
3809       		data final_exposureD;
3810       			err_msg = '';
3811       		 run;
3812       
3813       		/* determine which necessary variables were missing and compose an appropriate error message */
3814       		data final_exposureD_err;
3815       			length missvar $100;
3816       			missvar = compbl(ifc(&ex_extrt. ne 1,'EXTRT','')||' '||
3817                                    ifc(&ex_exdose. ne 1,'EXDOSE','')||' '||
3818                                    ifc(&ex_exdosu. ne 1,'EXDOSU','')
3819                                    );
3820       
3821       			if not (&ex_extrt. and &ex_exdose. and &ex_exdosu.) then do;
3822       				select (ifn(&ex_extrt. ne 1,1,0) + ifn(&ex_exdose. ne 1,1,0) + ifn(&ex_exdosu. ne 1,1,0));
3823       					when (1) ;
3824       					when (2) missvar = tranwrd(trim(missvar),' ',' and ');
3825       					otherwise do;
3826       						missvar = tranwrd(trim(missvar),' ',', ');
3827       						lastcomma = length(trim(missvar)) - index(left(reverse(missvar)),',') + 1;
3828       						missvar = substr(missvar,1,lastcomma-1)||', and '||substr(missvar,lastcomma+1);
3829       					end;
3830       				end;
3831       			end;
3832       
3833       			call symputx('extrt_missvar',missvar,'g');
3834       
3835       			missvar = compbl(missvar);
3836       
3837       			err_msg = 'Planned treatment could not be compared to actual treatment because '||
3838       			          ifc(not &dm_arm.,'ARM did not exist in the DM dataset ','')||
3839       					  ifc(not &dm_arm. and not (&ex_extrt. and &ex_exdose. and &ex_exdosu.),'and ','')||
3840                             ifc(not (&ex_extrt. and &ex_exdose. and &ex_exdosu.),
3841                                 trim(missvar)||' did not exist in the EX dataset','');
3842       			err_msg = strip(err_msg)||'.';
3843       			keep err_msg;
3844       		 run;
3845       
3846       	%end;
3847       
                                                           The SAS System

3848       %mend ex_4;
3849       
3850       
3851       /*******************/
3852       /* CHANGES IN DOSE */
3853       /*******************/
3854       %macro ex_5;
3855       
3856       	%put *******************************;
3857       	%put * 5. ANALYSIS E: DOSE CHANGES *;	
3858       	%put *******************************;
3859       
3860       	/* EXTRT, EXDOSE, and EXDOSU must exist to run this analysis */
3861       	%if &ex_extrt. and &ex_exdose. and &ex_exdosu. %then %do;
3862       
3863       		** LOOK FOR CHANGES IN DOSE ***;
3864       
3865       		** OUTPUT IF THERE IS A CHANGE IN TREATMENT OR DOSE FROM ONE RECORD TO THE NEXT ****;
3866       		data ex2;
3867       			set ex_dm;
3868       			format change_date mmddyy10. exadj $50.;
3869       			usubjid0 = lag(usubjid);
3870       			extrt0 = lag(extrt);
3871       			exdose0 = lag(exdose);
3872       			exdosu0 = lag(exdosu);
3873       			if exendtc ne "" then change_date = input(exendtc, yymmdd10.);
3874       			  else change_date = treatdate ;
3875       			if usubjid0 = usubjid;
3876       			if (extrt0 ne extrt) or (exdose0 ne exdose);
3877       			old_dose = left(trim(extrt0)|| ' '||compress(exdose0)||' '||compress(exdosu0));
3878       			new_dose = left(trim(extrt)|| ' '||compress(exdose)||' '||compress(exdosu));
3879       			if exadj = '' then exadj = 'Not Given';
3880       			else exadj = propcase(exadj);
3881       			label old_dose = 'Original Dose'
3882       			      new_dose = 'New Dose'
3883       				  usubjid = 'Subject ID'
3884       				  change_date = 'Change Date'
3885       				  studydays	= 'Day of Study'
3886       				  ;
3887       		run;
3888       
3889       
3890       		** SEE IF THERE WAS A CHANGE IN COUNT FOR OUTPUT **;
3891       
3892       		proc sql noprint;
3893       		  select count(*) into: changes
3894       		  from ex2;
3895       		quit;
3896       
3897       		%if %eval(&changes.) = 0 %then %do;
3898       
3899       			data final_exposureE;
3900       				usubjid = "No Reported Change in Dose";
3901       			run;
3902       
3903       		%end;
3904       		%else %do;
3905       
                                                           The SAS System

3906       			proc sql;
3907       			  create table final_exposureE
3908       			  as select usubjid, old_dose, new_dose, change_date, studydays, exadj
3909       			  from ex2
3910       			  order by usubjid, change_date;
3911       			;
3912       			quit;
3913       
3914       			data final_exposureE;
3915       				set final_exposureE(obs=2500) end=eof;
3916       				by usubjid change_date;
3917       				if not first.usubjid then do;
3918       					usubjid = '';
3919       				end;
3920       				output;
3921       				if _n_ = 2500 and eof then do;
3922       					usubjid = 'Over 2500 changes in dose';
3923       					old_dose = 'List truncated at 2500';
3924       					new_dose = '';
3925       					studydays = .;
3926       					exadj = '';
3927       					output;
3928       				end;
3929       			run;
3930       
3931       		%end;
3932       
3933       	%end;
3934       	%else %do;
3935       
3936       		data final_exposureE;
3937       			usubjid = '';
3938       		 run;
3939       
3940       		/* determine which necessary variables were missing and compose an appropriate error message */
3941       		data final_exposureE_err;
3942       			length missvar $100;
3943       			missvar = "&extrt_missvar.";
3944       
3945       			err_msg = compbl('Changes in dose could not be determined because '||
3946                             trim(missvar)||' did not exist in the EX dataset.');
3947       			keep err_msg;
3948       		 run;
3949       
3950       	%end;
3951       
3952       %mend ex_5;
3953       
3954       
3955       /***********************/
3956       /* CREATE EXCEL OUTPUT */
3957       /***********************/
3958       %macro ex_out;
3959       
3960       	%put *****************************************;
3961       	%put * CREATE EXPOSURE ANALYSIS EXCEL OUTPUT *;	
3962       	%put *****************************************;
3963       
                                                           The SAS System

3964       	** ADD IN THE DATA INFORMATION ***;
3965       	data lib;
3966       		length path $100;
3967       		path = "&ndabla.";
3968       		output;
3969       		path = "&studyid.";
3970       		output;
3971       		path = 	compbl(put(date(),e8601da.)||' '||put(time(),timeampm11.));
3972       		output;	
3973       		path = "&sl_custom_ds.";
3974       		output;	
3975       		path = ifc(&dm_actarm.,'actual treatment arm (ACTARM)','planned treatment arm (ARM)');
3976       		output;
3977       		path = ifc(&dm_actarm.,'Arm is actual arm','Arm is planned arm');
3978       		output;
3979       	run;
3980       
3981       	%if not %symexist(run_location) %then %let run_location = LOCAL;
3982       
3983       	/* local runs use the Microsoft Jet database-based Excel LIBNAME engine */
3984       	%if %upcase(&run_location.) = LOCAL %then %do;
3985       		*libname xls excel "&expout." ver=2003;*Output function changed due to SAS 9.3(64bit) and Excel 2010(32bit)
3985     ! incompatability;
3986       		libname xls pcfiles path="&expout.";
3987       	%end;
3988       	/* Script Launcher runs use the PCFILES LIBNAME Engine */
3989       	%else %do;
3990       		libname xls pcfiles path="&expout.";
3991       	%end;
3992       
3993       	proc sql noprint;
3994       		drop table xls.final_exposureA,
3995       		           xls.final_exposureB2,
3996       				   xls.final_exposureC,
3997       				   xls.pva,
3998       				   xls.dosechanges,
3999       	               xls.Info
4000                          ;
4001       	quit;
4002       	
4003       	data xls.final_exposureA(dblabel=yes);
4004       		set final_exposureA;
4005       	run;
4006       
4007       	data xls.final_exposureB2(dblabel=yes);
4008       		set final_exposureB;
4009       	run;
4010       
4011       	data xls.final_exposureC(dblabel=yes);
4012       		set final_exposureC;
4013       	run;
4014       
4015       	data xls.pva(dblabel=yes);
4016       		set final_exposureD;
4017       	run;
4018       
4019       	data xls.dosechanges(dblabel=yes);
4020       		set final_exposureE;
                                                           The SAS System

4021       	run;
4022       
4023       	data xls.info(dblabel=yes);
4024       		set lib;
4025       	run;
4026       
4027       	libname xls clear;
4028       
4029       %mend ex_out;
