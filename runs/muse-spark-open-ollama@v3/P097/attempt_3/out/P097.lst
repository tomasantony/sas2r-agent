299        
300        proc sgplot data=waterfall;
301            title4 j=c "Figure 14.2.3";
302            title5 j=c "Waterfall Plot of Best Percentage Change from Baseline in Sum of Target Lesions";
303        
304            /* Bars colored by best overall response */
305            vbar bar_order / response=PCHG_display
306                group=AVALC
307                groupdisplay=cluster
308                barwidth=1
309                outline outlineattrs=(color=black thickness=0.5px);
310        
311            /* Reference lines for RECIST thresholds */
312            refline -30 / axis=y lineattrs=(pattern=dash color=blue thickness=1px)
313                label='-30% (PR threshold)' labelattrs=(size=7pt);
314            refline 20 / axis=y lineattrs=(pattern=dash color=red thickness=1px)
315                label='+20% (PD threshold)' labelattrs=(size=7pt);
316            refline 0 / axis=y lineattrs=(color=black thickness=1px);
317        
318            xaxis display=none label=' ';
319            yaxis label="Best Percentage Change from Baseline (%)"
320                  values=(-100 to 100 by 20)
321                  grid gridattrs=(pattern=dot color=lightgray);
322        
323            keylegend / title='Best Overall Response'
324                location=outside position=bottom across=5;
325        
326            footnote1 j=l "Data cutoff: &cutdate.";
327            footnote2 j=l "Each bar represents one subject.";
328            footnote3 j=l "CR=Complete Response, PR=Partial Response, SD=Stable Disease, PD=Progressive Disease";
329            footnote4 j=l "Dashed lines: RECIST 1.1 thresholds for PR (-30%) and PD (+20%)";
330            footnote5 j=l "Program: &sysin. | Run: %sysfunc(date(), date9.)";
