312        
313        /*--- Step 1: Prepare listing data ---*/
314        proc sql noprint;
315            create table ae_list as
316            select a.USUBJID,
317                   b.TRTA,
318                   b.AGE, b.SEX, b.RACE,
319                   a.AEBODSYS as SOC,
320                   a.AEDECOD as PT,
321                   a.AETERM as VERBATIM,
322                   a.AESTDTC as START_DATE,
323                   a.AEENDTC as END_DATE,
324                   a.AESEV as SEVERITY,
325                   a.AEREL as RELATIONSHIP,
326                   a.AESER as SERIOUS,
327                   a.AEACN as ACTION_TAKEN,
328                   a.AEOUT as OUTCOME,
329                   a.AETOXGR as CTCAE_GRADE,
330                   a.TRTEMFL
331            from adam.adae a
332            inner join adam.adsl b on a.USUBJID = b.USUBJID
333            where b.SAFFL = 'Y' and a.TRTEMFL = 'Y'
334            order by b.TRTA, a.USUBJID, a.AESTDTC, a.AEBODSYS, a.AEDECOD;
                                                           The SAS System

NOTE: SAS threaded sort was used.
NOTE: Table WORK.AE_LIST created, with 345 rows and 17 columns.

335        quit;
NOTE: PROCEDURE SQL used (Total process time):
      real time           0.02 seconds
      user cpu time       0.01 seconds
      system cpu time     0.01 seconds
      memory              10889.46k
      OS Memory           19100.00k
      Timestamp           10/27/2026 03:47:05 PM
      Step Count                        2  Switch Count  0
      

336        
337        /*--- Step 2: Format display values ---*/
338        data ae_report;
339            set ae_list;
340            length severity_d $10 rel_d $15 serious_d $3 action_d $30 outcome_d $30;
341        
342            /* Truncate/format for display */
343            severity_d = propcase(SEVERITY);
344            rel_d = propcase(RELATIONSHIP);
345            serious_d = ifc(SERIOUS = 'Y', 'Yes', 'No');
346        
347            select(upcase(ACTION_TAKEN));
348                when('DRUG WITHDRAWN')     action_d = 'Drug Withdrawn';
349                when('DOSE REDUCED')       action_d = 'Dose Reduced';
350                when('DRUG INTERRUPTED')   action_d = 'Drug Interrupted';
351                when('DOSE NOT CHANGED')   action_d = 'Dose Not Changed';
352                when('NOT APPLICABLE')     action_d = 'Not Applicable';
353                otherwise                  action_d = propcase(ACTION_TAKEN);
354            end;
355        
356            select(upcase(OUTCOME));
357                when('RECOVERED/RESOLVED')            outcome_d = 'Resolved';
358                when('RECOVERING/RESOLVING')          outcome_d = 'Resolving';
359                when('NOT RECOVERED/NOT RESOLVED')    outcome_d = 'Not Resolved';
360                when('RECOVERED/RESOLVED WITH SEQUELAE') outcome_d = 'Resolved w/ Sequelae';
361                when('FATAL')                         outcome_d = 'Fatal';
362                otherwise                             outcome_d = propcase(OUTCOME);
363            end;
364        run;

