241            /*** Data Prep
242              1. Restrict analysis to SAFETY POP (&p_fl) and ANALYSIS RECORDS (&a_fl)
243              2. Replace AVISIT/AVISITN with values that distinguish BASE and POST values (as needed for box plot)
244              3. Plot requires 'Pooled' data with UNIQUE USUBJID for across-study results
245              4. Plot requires a Study-Visit variable for the X-Axis, to cluster boxes and stats
246            ***/
247              proc sort data=&m_lb..&m_ds (keep=&ana_variables
248                                           where=(&p_fl = 'Y' and &a_fl = 'Y'))
249                         out=css_safana;
250        
251                by studyid &tn_var paramcd atptn usubjid avisitn;
252              run;

