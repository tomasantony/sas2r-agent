179                attrib trtp_short length=$6 label='Planned Treatment, abbreviated';
180        
181                select (trtp);
182                  when ('Placebo')              trtp_short = 'P';
183                  when ('Xanomeline High Dose') trtp_short = 'X-high';
184                  otherwise                     trtp_short = 'UNEXPECTED';
185                end;
186              run;

