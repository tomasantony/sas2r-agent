51         /* ------------------------------------------ 3. Treatment dates ------- */
52         data adsl_trt;
53           set adsl_base;
54           length _dt 8;
                                                           The SAS System

55           format TRTSDT TRTEDT DTHDT date9.
56                  TRTSDTM TRTEDTM e8601dt19.;
57         
58           if not missing(RFXSTDTC) then do;
59             TRTSDT  = input(substr(RFXSTDTC, 1, 10), yymmdd10.);
60             TRTSDTM = input(RFXSTDTC, ?? e8601dt19.);
61           end;
62           if not missing(RFXENDTC) then do;
63             TRTEDT  = input(substr(RFXENDTC, 1, 10), yymmdd10.);
64             TRTEDTM = input(RFXENDTC, ?? e8601dt19.);
65           end;
66           if not missing(DTHDTC) then DTHDT = input(substr(DTHDTC, 1, 10), yymmdd10.);
67         
68           if not missing(TRTSDT) and not missing(TRTEDT) then
69             TRTDURD = TRTEDT - TRTSDT + 1;
70           drop _dt;
71         run;

