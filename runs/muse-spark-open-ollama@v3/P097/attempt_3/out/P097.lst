159        
160        **** Generate report ****;
161        
162        proc report data=final nowd headline headskip split='*' missing;
163          column cat subcat text col1 col2 col3 col4;
164        
165          define cat     / order order=internal noprint " ";
166          define subcat  / order order=internal noprint " ";
167          define text    / display width=30 left flow " ";
168          define col1    / display width=12 left "Group 1";
169          define col2    / display width=12 left "Group 2";
170          define col3    / display width=12 left "Group 3";
171          define col4    / display width=12 left "Total";
172        
