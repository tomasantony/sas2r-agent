37         %let syscc=0;
38         options mprint;
                                                           The SAS System

39         
40         %macro target13(PCTESTCD=, Meantype=A, SD=Y);
41         %if %upcase("&PCTESTCD") = " " %then
42           %put %str(E)RROR: Need to specify a variable to test;;
43         %if %upcase("&meantype") ne "G" and %upcase("&meantype") ne "A" %then
44           %put %str(E)RROR: Need to specify either Geometric or Arithmetic option;;
45         %if %upcase("&SD") ne "UPPER" and %upcase("&SD") ne "BOTH" and %upcase("&SD") ne "N"  %then
46           %put %str(E)RROR: Need to specify Upper, Both or No Bars;;
47         
48         
49         data work.adpc ;
50         set source.adpc(keep=ANLPRNT TRTAN ANLPRNT PCSPEC PCTESTL TRTA DOSREFID PCTESTCD
51                              PCORRESU PCORRES USUBJID  PCORRESN EPLTM);
52         
53           where PCTESTCD="&PCTESTCD";
54           PCTPT=input(EPLTM,best10.);
55           ORDERBY=compress( ANLPRNT||PCSPEC||PCTESTL||TRTAN); 	
56           BYVAL6=compbl(propcase(pctestcd)||' Conc '||' ('||PCORRESU||')');
57         run ;
58         
59         proc sort data=ADPC;
60          by TRTAN TRTA PCTPT;
61         run;
62         
63         %if &meantype=A %then %do;
64         
65           proc univariate data=ADPC noprint;
66              by TRTAN TRTA PCTPT;
67              var PCORRESN;
68         	 output out=PCMEANS mean=PCmean STD=PCSD ;
69           run;
70         
71           data MeanData;
72             set PCMEANS;
73         	if PCMEAN=0 then do;
74         	   PCMEAN=.;
75         	   PCSD=.;
76         	end;
77           run;
78         %end;
79         
80         %if &meantype=G %then %do;
81         
82           data LOGPC;
83             set ADPC;
84         	if PCORRESN ne . then LOGORRES=log(PCORRESN);
85           run;
86         
87           proc univariate data=LOGPC noprint;
88              by TRTAN TRTA PCTPT;
89              var PCORRESN;
90         	 output out=LogMEANS mean=Logmean STD=logSD ;
91           run;
92         
93           data MeanData;
94             set LogMEANS;
95             PCMEAN=EXP(LogMEANS);
96             PCSD=EXP(logSD);
                                                           The SAS System

97           run;
98         %end;
