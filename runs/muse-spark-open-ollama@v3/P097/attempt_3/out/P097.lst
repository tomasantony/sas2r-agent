MPRINT(DM_SETUP):   when ('mo','month','months') max_age_yr = age_sl/12;
MPRINT(DM_SETUP):   when ('wk','week','weeks') max_age_yr = age_sl/52.178571428571428571428571428571;
MPRINT(DM_SETUP):   when ('dy','day','days') max_age_yr = age_sl/365.25;
MPRINT(DM_SETUP):   when ('hr','hour','hours') max_age_yr = age_sl/8766;
MPRINT(DM_SETUP):   otherwise max_age_yr = .;
MPRINT(DM_SETUP):   end;
