3927       /* LIVER LAB ANALYSIS SETUP */
3928       /****************************/
3929       %macro liver_setup;
3930       
3931       	%put LIVER LAB SETUP;
3932       
3933       	/* used ACTARM if it is available */
3934       	%if &dm_actarm. %then %do;
3935       		proc datasets library=work;
3936       			modify dm;
3937       			rename %if &dm_arm. %then arm=plannedarm;
3938       			       actarm=arm;
3939       		quit;
3940       	%end;
3941       
3942       	/*Put dataset into Work Library for manipulation*/;	
3943       	data demographics;
3944       		set dm;
3945       
3946       		%if &dm_armcd. %then %do;
3947       			if upcase(ARMCD) in("SCRNFAIL","NOTASSGN") then delete;
3948       		%end;
3949       
3950       		keep ARM USUBJID RFSTDTC;
3951       		/* added by DK */
3952       		arm_display = arm;
3953       		if arm_display ne '' and not anylower(arm_display) then do;
3954       			length arm_word $50;
3955       			i = 1;
3956       			arm_word = scan(arm_display,i);
3957       			do while (arm_word ne '');
3958       				if length(arm_word) > 3 and not anydigit(compress(arm_word))
3959       						then substr(arm_display,index(arm_display,compress(arm_word)),length(compress(arm_word))) =
3959     ! propcase(compress(arm_word));
3960       				if compress(arm_word) in ('MG' 'KG')
3961       					then substr(arm_display,index(arm_display,compress(arm_word)),length(compress(arm_word))) = lowcase(arm_word);
3962       				if compress(arm_word) = ('ML')
3963       					then substr(arm_display,index(arm_display,compress(arm_word)),length(compress(arm_word))) = 'mL';
3964       				i = i + 1;
3965       				arm_word = scan(arm_display,i);
3966       			end;
3967       		end;
3968       		arm = arm_display;
3969       		drop arm_display arm_word i;
3970       	run;
3971       
3972       	/*greate global macro for the number of arms*/
3973       	proc freq data = demographics noprint;
3974       	table arm/out=treatment_arms;
3975       	run;
3976       
                                                           The SAS System

3977       	data treatment_arms;
3978       	set treatment_arms;
3979       	treatment = _N_;
3980       	run;
3981       
3982       	proc summary data = treatment_arms;
3983       	output out = num;
3984       	run;
3985       
3986       	data _null_;
3987       	set num;
3988       	call symputx('num', put(_freq_,1. -l),'g');
3989       	run;
