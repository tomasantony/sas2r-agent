3991       	/*bring in all datasets with lb and subset only the 4 liver labs*/
3992       	data labdata;
3993       		set lb;
3994       
3995       		%if not &lb_lbtest. %then %do;
3996       			length lbtest $40;
3997       		%end;
3998       
3999       		if LBTESTCD in (&l_alp.,&l_alt.,&l_ast.,&l_bili.);
4000       		if LBTESTCD in (&l_alt.) then LBTEST = "Alanine Aminotransferase";
4001       		if LBTESTCD in (&l_ast.) then LBTEST = "Aspartate Aminotransferase";
4002       		if LBTESTCD in (&l_bili.) then LBTEST = "Total Bilirubin";
4003       		if LBTESTCD in (&l_alp.) then LBTEST = "Alkaline Phosphatase";
4004       		if LBSTNRHI = . or LBSTNRHI = 0 then delete;
4005       	run;
