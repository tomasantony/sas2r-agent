132        
133        *4. Calculate Ix= number of people living at the begining of each age interval;
134        Data test2;
135           Set test1;
136           Length x xx Ix 8;
137           If years=1 then Do;
138                x=1;
139        		x=x*p;
140        		xx=1;
141        		Ix=100000;
142           End;
143           Else do;
144           		Retain x;
145                xx=x;
146        		Ix=100000*xx;
