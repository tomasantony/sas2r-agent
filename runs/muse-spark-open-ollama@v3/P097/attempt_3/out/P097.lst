4714       		/*count instances of baseline and maximum values above normal*/
4715       		data dili_blmax_arm&i.;
4716       			set labdata_bl_max;
4717       			if arm = "&&arm&i.";
4718       			if (bllab < blHI*2) then bllab_1 = 1;
4719       			if (LBSTNRHI*2 <= bllab < blHI*5) then bllab_2 = 1;
4720       			if (LBSTNRHI*5 <= bllab < blHI*10) then bllab_3 = 1;
4721       			if (LBSTNRHI*10 <= bllab < blHI*20) then bllab_4 = 1;
4722       			if (bllab >= blHI*20) then bllab_5 = 1;
4723       			if (maxlab < LBSTNRHI*2) then maxlab_1 = 1;
4724       			if (LBSTNRHI*2 <= maxlab < LBSTNRHI*5) then maxlab_2 = 1;
4725       			if (LBSTNRHI*5 <= maxlab < LBSTNRHI*10) then maxlab_3 = 1;
4726       			if (LBSTNRHI*10 <= maxlab < LBSTNRHI*20) then maxlab_4 = 1;
4727       			if (maxlab >= LBSTNRHI*20) then maxlab_5 = 1;
4728       		run;
