344         options orientation=landscape LEFTMARGIN=1.5in RIGHTMARGIN=1 in
344      ! TOPMARGIN=1in BOTTOMMARGIN=1in;
345         title1    h=10pt "Laborary Analysis - Box Plot of &label";
346        
347         Footnote1 JUSTIFY= LEFT h=0.9 'Box plot type=schematic, the box
347      ! shows median,interqutile range (IQR, edge of the bar), Min and Max'
348          ' within 1.5 IQR below 25% and above 75% (ends of the whisker).';
349         Footnote2 Justify=left h=0.9 'Values outside the 1.5 IQR below 25%
349      ! and above 75% are shown as outliers. Means ploted as different'
350          ' symbols by treatments. Red dots indicate out of normal reference
350      ! range measures.';
351         Footnote3 Justify=left h=0.9 'The upper and lower limits use the
351      ! most conservative ones if they differ by'
352          ' gender, age, etc.  xxxx reference range is used. Baseline and
352      ! postbaseline boxes are framed in different colors.';
353         Footnote4 Justify=left h=0.9 'BSE=baseline        PST=post-baseline'
353      ! ;
354        
355        
356         symbol1 v=circle h=0.8 c=green;
357         symbol2 v=star h=0.8 c=purple;
358          legend1 label=(h=8pt 'Treatment') value=(h=6pt);
359         axis1  value=(height=0.1 color=white) label=( h=0.1 c=white
359      ! "Baseline vs. Postbaseline by Treatment") major=none Minor=none;
360         axis2  label=(j=c h=1  "xxx Measure (Unit)") Minor=(n=4);
