1          /******************************************************************
2          * PROGRAM NAME :  log_list_prep.sas
                                                           The SAS System

3          * DESCRIPTION :   prepare and modify log and list
4          * AUTHOR:         zeke torres
5          * LinkedIn:       https://www.linkedin.com/in/zeketorres/
6          *******************************************************************/
7          
8          /* obtain the path and number of sections of that path
9          ******************************************************/
10         data _null_;
11             cpy_sys_var1 ="%sysfunc(getoption(SYSIN))";
12             call symput('cpy_sys_path'  ,cpy_sys_var1);
13         run;

NOTE: DATA statement used (Total process time):
