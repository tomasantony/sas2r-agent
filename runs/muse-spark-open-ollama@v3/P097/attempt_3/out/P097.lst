63         	run;
64         
65         	data &out;
66         	 set &in;
67         	 by id visit;
68         	 length label $ 40.;
69         	 length category $15;
70         	 keep visit id trt category label point result;
71         	 retain min&out max&out;
72         	 if first.id then do;
73         	   min&out=lab_test_1;
