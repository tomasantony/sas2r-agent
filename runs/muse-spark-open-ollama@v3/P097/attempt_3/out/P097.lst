75         /* SAFFL = Y if subject has >=1 EX record with non-missing EXTRT
76          * (Placebo has EXDOSE=0 in pharmaversesdtm, so use EXTRT not EXDOSE). */
77         proc sql;
78           create table _saf as
79             select distinct STUDYID, USUBJID, "Y" as SAFFL length=1
80             from ex
81             where not missing(EXTRT);
NOTE: Table WORK._SAF created, with 254 rows and 3 columns.

