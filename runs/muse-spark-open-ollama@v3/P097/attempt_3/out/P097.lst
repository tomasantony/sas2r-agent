311        ods output close;
312        
313        data _sg_overall;
314            set _pe_overall;
315            where Parameter = 'TRTA';
316            length subgroup $60 subgroup_level $60;
317            subgroup = 'Overall';
318            subgroup_level = 'All Subjects';
319            subgrp_ord = 0;
320            HR = exp(Estimate);
321            HR_LCL = exp(Estimate - 1.96 * StdErr);
322            HR_UCL = exp(Estimate + 1.96 * StdErr);
323            length hr_display $30 ci_display $40;
                                                           The SAS System

324            hr_display = strip(put(HR, 5.2));
325            ci_display = cat('(', strip(put(HR_LCL, 5.2)), ', ',
326                                  strip(put(HR_UCL, 5.2)), ')');
327            keep subgroup subgroup_level subgrp_ord HR HR_LCL HR_UCL
328                 hr_display ci_display ProbChiSq;
329        run;

