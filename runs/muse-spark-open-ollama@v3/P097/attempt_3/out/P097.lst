473            /* Assign display order for reasons */
474            select(upcase(DCSREAS));
475                when('ADVERSE EVENT')          ord = 12;
476                when('DEATH')                  ord = 13;
477                when('LACK OF EFFICACY')       ord = 14;
478                when('LOST TO FOLLOW-UP')      ord = 15;
479                when('PHYSICIAN DECISION')     ord = 16;
480                when('PROTOCOL VIOLATION')     ord = 17;
481                when('WITHDRAWAL BY SUBJECT')  ord = 18;
482                otherwise                      ord = 19;
483            end;
484        run;

