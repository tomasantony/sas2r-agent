90         ods graphics / push width=480px height=720px;
91         title "State Populations (2020)";
92         title2 "Ordered by State Name (Alabama First)";
93         proc sgplot data=StatePop;
94            hbar StateName / response=PopM;
95            yaxis display=(nolabel) valueattrs=(size=8) /* small font for values */
