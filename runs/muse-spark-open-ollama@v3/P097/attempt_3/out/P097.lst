146              data &ds._sub;
147                set work.&ds;
148                where (paramcd in (&param) and atptn in (815 817));
149        
150                attrib trtp_short length=$6 label='Planned Treatment, abbreviated';
151        
152                select (trtp);
153                  when ('Placebo')              trtp_short = 'P';
154                  when ('Xanomeline High Dose') trtp_short = 'X-high';
155                  when ('Xanomeline Low Dose')  trtp_short = 'X-low';
156                  otherwise                     trtp_short = 'UNEXPECTED';
157                end;
158              run;

