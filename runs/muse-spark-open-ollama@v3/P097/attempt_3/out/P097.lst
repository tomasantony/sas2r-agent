67         
68         /* COUNT UNIQUE SUBJECTS BY TREATMENT */
69         CREATE TABLE AESUBD AS
70         SELECT COUNT(distinct usubjid) AS count, TRTAN
71         FROM ADAE(where=(TRTEMFL='Y' and AESER='Y'))
72         GROUP BY TRTAN
73         ORDER BY TRTAN;
NOTE: SAS threaded sort was used.
NOTE: Table WORK.AESUBD created, with 2 rows and 2 columns.

74         ** COUNT ALL EVENTS BY TREATMENT **;
75         CREATE TABLE AESUBA AS
76         SELECT COUNT(usubjid) AS events, TRTAN
77         FROM ADAE(where=(TRTEMFL='Y' and AESER='Y'))
78         GROUP BY TRTAN
79         ORDER BY TRTAN;
NOTE: SAS threaded sort was used.
NOTE: Table WORK.AESUBA created, with 2 rows and 2 columns.

80         ** GET RESULTS AT SUBJECT LEVEL **;
81         create table RESULTSUB as select a.*, 1 as SUMMARYLEVEL, b.DENOM, c.events,
                                                           The SAS System

82         strip(put(count,best.))||' ('||strip(put((count/denom)*100,8.1))||'%) ['||strip(put(events,best.))||']'
83         as RESULT LENGTH=50
84         from AESUBD as A left join DENOM as b
85         on a.TRTAN=b.TRTAN
86         left join AESUBA as c
87         on a.TRTAN=c.TRTAN
88         order by TRTAN;
NOTE: Table WORK.RESULTSUB created, with 2 rows and 6 columns.

