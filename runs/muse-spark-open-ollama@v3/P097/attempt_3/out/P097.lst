MPRINT(GROUP_SUBSET_PP):   if dsid then do;
MPRINT(GROUP_SUBSET_PP):   varnum = varnum(dsid,upcase(var_name));
MPRINT(GROUP_SUBSET_PP):   if varnum then varlabel = varlabel(dsid,varnum);
MPRINT(GROUP_SUBSET_PP):   end;
MPRINT(GROUP_SUBSET_PP):   end;
MPRINT(GROUP_SUBSET_PP):   if last.subset_name then do;
MPRINT(GROUP_SUBSET_PP):   rc = close(dsid);
MPRINT(GROUP_SUBSET_PP):   end;
MPRINT(GROUP_SUBSET_PP):   length var_desc $300;
MPRINT(GROUP_SUBSET_PP):   if not missing(varlabel) then var_desc = trim(varlabel)||' ('||trim(var_name)||')';
MPRINT(GROUP_SUBSET_PP):   else var_desc = var_name;
MPRINT(GROUP_SUBSET_PP):   length condition $10;
MPRINT(GROUP_SUBSET_PP):   retain condition_no condition_sub_no;
MPRINT(GROUP_SUBSET_PP):   if first.subset_name then do;
MPRINT(GROUP_SUBSET_PP):   condition_no + 1;
MPRINT(GROUP_SUBSET_PP):   condition_sub_no = 0;
                                                           The SAS System

MPRINT(GROUP_SUBSET_PP):   end;
MPRINT(GROUP_SUBSET_PP):   if first.partition or first.var_name then condition_sub_no + 1;
MPRINT(GROUP_SUBSET_PP):   condition = trim(put(condition_no,8. -l))||'.'||trim(put(condition_sub_no,8. -l));
MPRINT(GROUP_SUBSET_PP):   length partition_desc $300;
MPRINT(GROUP_SUBSET_PP):   call missing(partition_desc);
MPRINT(GROUP_SUBSET_PP):   if not missing(partition) then partition_desc = partition;
MPRINT(GROUP_SUBSET_PP):   else partition_desc = 'N/A';
MPRINT(GROUP_SUBSET_PP):   length operator $50;
MPRINT(GROUP_SUBSET_PP):   call missing(operator);
MPRINT(GROUP_SUBSET_PP):   if first.subset_name then do;
MPRINT(GROUP_SUBSET_PP):   if _n_ = 1 then do;
MPRINT(GROUP_SUBSET_PP):   declare hash h2(dataset:'sl_subset_condition');
MPRINT(GROUP_SUBSET_PP):   h2.definekey('subset_name');
MPRINT(GROUP_SUBSET_PP):   h2.definedata('condition_count');
MPRINT(GROUP_SUBSET_PP):   h2.definedone();
MPRINT(GROUP_SUBSET_PP):   end;
MPRINT(GROUP_SUBSET_PP):   length condition_count 8.;
MPRINT(GROUP_SUBSET_PP):   call missing(condition_count);
MPRINT(GROUP_SUBSET_PP):   rc = h2.find();
MPRINT(GROUP_SUBSET_PP):   drop rc;
MPRINT(GROUP_SUBSET_PP):   if inner_operator ne '' then do;
MPRINT(GROUP_SUBSET_PP):   do i = 1 to condition_count;
MPRINT(GROUP_SUBSET_PP):   operator = left(trim(operator))||' '||trim(put(condition_no,8. -l))||'.'|| trim(put(i,8. -l))||' 
'||ifc(i<condition_count,upcase(inner_operator),'');
MPRINT(GROUP_SUBSET_PP):   end;
MPRINT(GROUP_SUBSET_PP):   select(inner_operator);
MPRINT(GROUP_SUBSET_PP):   when ('OR') operator = 'Condition '||operator;
MPRINT(GROUP_SUBSET_PP):   when ('AND') operator = 'Conditions '||operator;
MPRINT(GROUP_SUBSET_PP):   otherwise;
MPRINT(GROUP_SUBSET_PP):   end;
MPRINT(GROUP_SUBSET_PP):   operator = compbl(operator);
MPRINT(GROUP_SUBSET_PP):   end;
MPRINT(GROUP_SUBSET_PP):   else operator = 'N/A';
MPRINT(GROUP_SUBSET_PP):   end;
MPRINT(GROUP_SUBSET_PP):   if not first.subset_name then do;
MPRINT(GROUP_SUBSET_PP):   subset_name = '';
MPRINT(GROUP_SUBSET_PP):   end;
MPRINT(GROUP_SUBSET_PP):   if not first.domain then domain = '';
MPRINT(GROUP_SUBSET_PP):   if not first.partition then partition_desc = '';
MPRINT(GROUP_SUBSET_PP):   if not first.var_name then do;
MPRINT(GROUP_SUBSET_PP):   var_desc = '';
MPRINT(GROUP_SUBSET_PP):   condition = '';
MPRINT(GROUP_SUBSET_PP):   end;
