434        
435        /*--- Step 4: Get worst post-baseline grade ---*/
436        proc sql noprint;
437            create table worst_grade as
438            select USUBJID, TRTA, TRTAN, PARAMCD,
439                   max(input(ATOXGR, best.)) as worst_grade_n
440            from lb
