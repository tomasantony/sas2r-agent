354        	 by id visit;
355        	 length label $ 40.;
356        	 length category $15;
357        	 keep visit id trt category label point result;
358        	 retain min&out max&out;
359        	 if first.id then do;
360        	   min&out=lab_test_1;
361        	   max&out=lab_test_1;
362        	 end;
363        	 else do;
364        	  if min&out>lab_test_1 then min&out=lab_test_1;
365        	  if max&out<lab_test_1 then max&out=lab_test_1;
366        	 end;
367        	 if last.id then do;
                                                           The SAS System

368        	  category="&out";
369        	  label="Last baseline to last postbaseline";
