90               data advs_sub;
91                 set work.advs;
                                                           The SAS System

92                 where (paramcd in ('DIABP') and atptn in (815)) or
93                       (paramcd in ('SYSBP') and atptn in (816));
94         
95                 attrib trtp_short length=$6 label='Planned Treatment, abbreviated';
96         
97                 select (trtp);
98                   when ('Placebo')              trtp_short = 'P';
99                   when ('Xanomeline High Dose') trtp_short = 'X-high';
100                  when ('Xanomeline Low Dose')  trtp_short = 'X-low';
101                  otherwise                     trtp_short = 'UNEXPECTED';
102                end;
103              run;

