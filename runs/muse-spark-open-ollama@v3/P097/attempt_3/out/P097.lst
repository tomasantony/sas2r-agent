257        
258        /* Alternative: Derive from ADRS if ADTR not available */
259        /*
260        proc sql noprint;
261            create table tumor as
262            select a.USUBJID, a.TRTA, a.TRTAN,
263                   min(a.PCHG) as PCHG,
264                   b.AVALC as BOR
265            from adam.adrs a
266            inner join adam.adsl b on a.USUBJID = b.USUBJID
267            where b.EFFFL = 'Y' and a.PARAMCD = 'SUMLD'
268            group by a.USUBJID, a.TRTA, a.TRTAN, b.AVALC;
269        quit;
270        */
271        
272        /*--- Step 2: Assign display order (sorted by percent change) ---*/
273        data waterfall;
274            set tumor;
275            by PCHG;
276            bar_order = _n_;
277        
278            /* Color by response category */
279            length bar_color $20;
280            select(upcase(AVALC));
281                when('CR') bar_color = 'darkgreen';
282                when('PR') bar_color = 'green';
283                when('SD') bar_color = 'gold';
284                when('PD') bar_color = 'red';
285                otherwise  bar_color = 'gray';
286            end;
287        
288            /* Cap at reasonable bounds */
289            if PCHG > 100 then PCHG_display = 100;
290            else if PCHG < -100 then PCHG_display = -100;
291            else PCHG_display = PCHG;
292        run;

