259        
260                data css_safana;
261                  set css_safana;
262                  by studyid &tn_var paramcd atptn usubjid avisitn;
263        
264                  *--- Replace AVISIT and AVISITN with plot-specific values ---*;
265                    attrib avisit length=$4 label='BASE or POST, to match user-specified Baseline and Post-baseline visits';
266        
267                    if first.usubjid and not last.usubjid then do;
268                      avisit = 'BASE';
269                      avisitn= 1;
270                    end;
271                    else if not first.usubjid and last.usubjid then do;
272                      avisit = 'POST';
273                      avisitn= 2;
274                    end;
275                    else do;
276                      if first.usubjid then put 'WARNING: (WPCT-F.07.08) Expecting exactly 2 visits (not 1) for ' &tn_var= usubjid= paramcd= atptn= avisitn=;
277                      else put 'WARNING: (WPCT-F.07.08) Unexpected extra visit for ' &tn_var= usubjid= paramcd= atptn= avisitn=;
278                      avisit = 'UNK';
279                      avisitn=99;
280                    end;
281        
282                  *--- Create a Normal Range Outlier variable, for scatter plot overlay ---*;
283                    if (2 = n(&m_var, &lo_var) and &m_var < &lo_var) or
284                       (2 = n(&m_var, &hi_var) and &m_var > &hi_var) then m_var_outlier = &m_var;
285                    else m_var_outlier = .;
286                run;

