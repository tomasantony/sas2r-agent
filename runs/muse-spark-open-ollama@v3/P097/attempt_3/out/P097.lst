186        data adam.adsl;
187          retain
188            STUDYID USUBJID SUBJID SITEID AGE AGEU AGEGR1 AGEGR1N SEX SEXN
189            RACE RACEN ETHNIC COUNTRY ARM ARMCD ACTARM ACTARMCD TRT01P TRT01A
190            RFSTDTC RFENDTC RFXSTDTC RFXENDTC TRTSDT TRTEDT TRTSDTM TRTEDTM
191            TRTDURD DTHDTC DTHDT DTHFL DCSREAS DCSREASP EOSSTT EOTSTT
192            SAFFL ITTFL EFFFL;
193          set adsl_eff;
194        
195          /* Labels (must match metadata/adsl_spec.xlsx) */
196          label
197            STUDYID  = "Study Identifier"
198            USUBJID  = "Unique Subject Identifier"
199            SUBJID   = "Subject Identifier for the Study"
200            SITEID   = "Study Site Identifier"
201            AGE      = "Age"
202            AGEU     = "Age Units"
203            AGEGR1   = "Pooled Age Group 1"
204            AGEGR1N  = "Pooled Age Group 1 (N)"
205            SEX      = "Sex"
206            SEXN     = "Sex (N)"
207            RACE     = "Race"
208            RACEN    = "Race (N)"
209            ETHNIC   = "Ethnicity"
