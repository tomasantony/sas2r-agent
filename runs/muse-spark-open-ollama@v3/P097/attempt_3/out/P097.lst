3234       /*********************************************/
3235       /* DEMOGRAPHICS INFORMATION FOR VARIABLE VAR */
                                                           The SAS System

3236       /*********************************************/
3237       %macro dm(var);
3238       
3239       	%put DEMOGRAPHICS: &var.;
3240       
3241       	data _null_;
3242       		var = "&var.";
3243       		outds = translate(var,'_','*');
3244       		varlist = translate(var,',','*');
3245       		keylist = substr(var,1,length(trim(var)) - index(reverse(left(trim(var))),'*'));
3246       
3247       		call symputx('outds',outds);
3248       		call symputx('varlist',varlist);
3249       		call symputx('keylist',keylist);
3250       	run;
3251       
3252       	proc sql noprint;
3253       		create table dm_&outds. as
3254       		select &varlist.,
3255       		       %do di = 1 %to &arm_count.;
3256                         arm_&di._count label="&&&arm_name_&di. Count",
3257       				  100*arm_&di._count/&&&arm_count_&di. as arm_&di._pct label="&&&arm_name_&di. %",
3258       			   %end;
3259       			   total_count label='Total Count',
3260       			   100*total_count/&total_count. as total_pct label='Total %'
3261       		from (select &varlist.,
3262       		             %do di = 1 %to &arm_count.;
3263       					    sum(case when arm_num = &di. then 1 else 0 end) as arm_&di._count,
3264       					 %end;
3265       					 count(1) as total_count
3266       			  from dm
3267       			  group by &varlist.)
3268       		order by &keylist., total_count desc;
3269       	quit;
3270       	
3271       %mend dm;
3272       
3273       
3274       /*******************************************/
3275       /* DEMOGRAPHIC STATISTICS FOR VARIABLE VAR */
3276       /*******************************************/
3277       %macro dm_stat(ds,var);
3278       
3279       	%put DEMOGRAPHIC STATISTICS FOR &var. in &ds.;
3280       
3281       	%let outds = %sysfunc(ifc(%sysfunc(index(&ds.,ds)),ds,dm));
3282       
3283       	proc sort data=&ds.;
3284       		by %if &outds. = ds %then dsdecod; arm_num;
3285       	run;
3286       
3287       	/* get statistics by arm */
3288       	proc univariate data = &ds. noprint;
3289       		var &var.;
3290       		output out=&outds._&var._stat_arm_x
3291                      mean=mean
3292                      median=median
3293                      min=min
                                                           The SAS System

3294                      max=max
3295                      mode=mode
3296                      std=std
3297       			   q1=q1
3298                      q3=q3
3299                      ;
3300       		by %if &outds. = ds %then dsdecod; arm_num;
3301       	run;
3302       
3303       	data &outds._&var._stat_arm_x;
3304       		retain %if &outds. = ds %then dsdecod; arm_num mean std mode min q1 median q3 max;
3305       		set &outds._&var._stat_arm_x;
3306       
3307       		/* calculate values used to build the chart in Excel */
3308       		chart_pct25 = q1;
3309       		chart_pct50 = median - q1;
3310       		chart_pct75 = q3 - median;
3311       		chart_min = q1 - min;
3312       		chart_max = max - q3;
3313       	run;
3314       
3315       	/* merge statistics onto arm numbers to ensure that every arm has an observation */
3316       	data &outds._&var._stat_arm_x;
3317       		merge lkp_arm(in=a keep=arm_num)
3318       		      &outds._&var._stat_arm_x(in=b);
3319       		by arm_num;
3320       		if a;
3321       	run;
3322       
3323       	proc transpose data=&outds._&var._stat_arm_x
3324       	                out=&outds._&var._stat_arm
3325       				   prefix=arm_;
3326       		id arm_num;
3327       		%if &outds. = ds %then by dsdecod;;
3328       	run;
3329       
3330       	/* get statistics overall */
3331       	proc univariate data = &ds. noprint;
3332       		var &var.;
3333       		output out=&outds._&var._stat_all_x
3334                      mean=mean
3335                      median=median
3336                      min=min
3337                      max=max
3338                      mode=mode
3339                      std=std
3340       			   q1=q1
3341                      q3=q3
3342                      ;
3343       		by %if &outds. = ds %then dsdecod;;
3344       	run;
3345       
3346       	data &outds._&var._stat_all_x;
3347       		retain %if &outds. = ds %then dsdecod; mean std mode min q1 median q3 max;
3348       		set &outds._&var._stat_all_x;
3349       
3350       		/* calculate values used to build the chart in Excel */
3351       		chart_pct25 = q1;
                                                           The SAS System

3352       		chart_pct50 = median - q1;
3353       		chart_pct75 = q3 - median;
3354       		chart_min = q1 - min;
3355       		chart_max = max - q3;
3356       	run;
3357       
3358       	proc transpose data=&outds._&var._stat_all_x
3359       	                out=&outds._&var._stat_all(rename=(col1=arm_%eval(&arm_count.+1)));
3360       		%if &outds. = ds %then by dsdecod;;
3361       	run;
3362       
3363       	/* combine per-arm statistics and overall statistics */
3364       	data &outds._&var._stat;
3365       		set &outds._&var._stat_arm;
3366       		set &outds._&var._stat_all;
3367       	run;
3368       
3369       	/* put the variables in order */
3370       	/* combine mean and standard deviation */
3371       	data &outds._&var._stat(drop=%do i = 1 %to &arm_count.+1; arm_&i._n %end;)
3372                &outds._&var._chart(keep=stat %do i = 1 %to &arm_count.+1; arm_&i._n %end;);
3373       		retain %if &outds. = ds %then dsdecod; _name_ _label_ %do i = 1 %to &arm_count.; arm_&i. %end;;
3374       		set &outds._&var._stat(rename=(%do i = 1 %to &arm_count. + 1; arm_&i.=arm_&i._n  %end;));
3375       
3376       		%do i = 1 %to &arm_count. + 1;
3377       			length arm_&i. $15;
3378       			arm_&i. = compress(arm_&i._n);
3379       
3380       			retain mean_&i._n;
3381       			if _name_ = 'mean' then do;
3382       				mean_&i._n = arm_&i._n;
3383       			end;
3384       			else if _name_ = 'std' then do;
3385       				arm_&i. = trim(put(mean_&i._n,8.1 -l))||' ('||trim(put(arm_&i._n,8.1 -l))||')';
3386       			end;
3387       
3388       			%if &i. <= &arm_count. %then %do;
3389       				label arm_&i.="&&&arm_name_&i.";
3390       			%end;
3391       			%else %do;
3392       				label arm_&i.='Total';
3393       			%end;
3394       
3395       			drop mean_&i._n;
3396       		%end;
3397       
3398       		rename arm_%eval(&arm_count.+1) = total;
3399       
3400       		if _name_ = 'mean' then delete;
3401       		else do;
3402       			select (_name_);
3403       				when ('std')    _label_ = 'Mean (SE)';
3404       				when ('mode')   _label_ = 'Mode';
3405       				when ('max')    _label_ = 'Max';
3406       				when ('q3')     _label_ = 'Q3';
3407       				when ('median') _label_ = 'Median';
3408       				when ('q1')     _label_ = 'Q1';
3409       				when ('min')    _label_ = 'Min';
                                                           The SAS System

3410       
3411       
3412       				otherwise;
3413       			end;
3414       		end;
3415       
3416       		if index(_name_,'chart') then do;
3417       			_label_ = _name_;
3418       			output &outds._&var._chart;
3419       		end;
3420       		else output &outds._&var._stat;
3421       
3422       		rename _label_=stat;
3423       		label _label_=' ';
3424       		drop _name_;
3425       	run;
3426       
3427       /*	proc datasets library=work nolist nodetails; delete &outds._&var._stat_:; quit;*/
3428       
3429       %mend dm_stat;
3430       
3431       
3432       /************************************************************/
3433       /* DEMOGRAPHICS BY DISPOSITION INFORMATION FOR VARIABLE VAR */
3434       /************************************************************/
3435       %macro dm_by_ds(var);
3436       
3437       	%put DEMOGRAPHICS BY DISPOSITION: &var.;
3438       
3439       	/* find the counts of demographic subgroups per disposition event and arm */
3440       	proc freq data=ds_dm noprint;
3441       		table &var.*arm_num*dsdecod / out=ds_&var._ct_c(keep=&var. arm_num dsdecod count) sparse;
3442       	run;
3443       
3444       	/* and the counts of demographic subgroups per arm */
3445       	/* and the counts of demographic subgroups */
3446       	proc freq data=dm noprint;
3447       		table &var.*arm_num / out=ds_&var._ct_sac(keep=&var. arm_num count rename=(count=subgroup_arm_count)) sparse;
3448       		table &var. / out=ds_&var._ct_sc(keep=&var. count rename=(count=subgroup_count)) sparse;
3449       	run;
3450       
3451       	/* merge disposition event counts and subgroup counts and calculate percentage of subgroup */
3452       	data ds_&var._ct_cp;
3453       		merge ds_&var._ct_c(in=a)
3454       		      ds_&var._ct_sac(in=b);
3455       			  if a;
3456       		by &var. arm_num;
3457       
3458       		if subgroup_arm_count ne 0 then percent = 100*count/subgroup_arm_count;
3459       		/*else percent = 0;*/
3460       
3461       		drop subgroup_arm_count;
3462       	run;
3463       
3464       	proc sort data=ds_&var._ct_cp; by &var. dsdecod arm_num; run;
3465       
3466       	/* merge arm counts and percentages onto arm numbers to ensure that every arm has an observation */
3467       	proc sort data=ds_&var._ct_cp; by arm_num; run;
                                                           The SAS System

3468       
3469       	data ds_&var._ct_cp;
3470       		merge lkp_arm(in=a keep=arm_num)
3471       		      ds_&var._ct_cp(in=b);
3472       		by arm_num;
3473       		if a;
3474       		/* set missing counts and percentages to zero */
3475       		array num{*} _numeric_;
3476       		do i = 1 to dim(num);
3477       			if a and not b and num(i) = . then num(i) = 0;
3478       		end;
3479       		drop i;
3480       	run;
3481       
3482       	proc sort data=ds_&var._ct_cp; by &var. dsdecod; run;
3483       
3484       	/* tranpose so arm counts are stored in separate columns */
3485       	proc transpose data=ds_&var._ct_cp out=ds_&var._count(drop=_name_ _label_) prefix=arm_ suffix=_count;
3486       		by &var. dsdecod;
3487       		id arm_num;
3488       		var count;
3489       	run;
3490       
3491       	/* and again for percentages */
3492       	proc transpose data=ds_&var._ct_cp out=ds_&var._percent(drop=_name_) prefix=arm_ suffix=_percent;
3493       		by &var. dsdecod;
3494       		id arm_num;
3495       		var percent;
3496       	run;
3497       
3498       	data ds_&var.;
3499       		merge ds_&var._count(in=a)
3500       		      ds_&var._percent(in=b);
3501       		by &var. dsdecod;
3502       	run;
3503       
3504       	/* find total counts and percentages */
3505       	data ds_&var.;
3506       		retain dsdecod &var. %do di = 1 %to &arm_count.; arm_&di._count arm_&di._percent %end;;
3507       		merge ds_&var.(in=a)
3508                     ds_&var._ct_sc(in=b);
3509       			  if a;
3510       		by &var.;
3511       		
3512       		total_count = %do di = 1 %to &arm_count; arm_&di._count + %end; 0;
3513       		if subgroup_count ne 0 then total_percent = 100*total_count/subgroup_count;
3514       		/*else total_percent = 0;*/
3515       
3516       		drop subgroup_count;
3517       	run;
3518       
3519       	proc sort data=ds_&var.; by dsdecod descending total_percent; run;
3520       
3521       /*	proc datasets library=work nolist nodetails; delete ds_&var._:; quit;*/
3522       
3523       %mend dm_by_ds;
3524       
3525       
